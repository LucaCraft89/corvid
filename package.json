{
  "name": "corvid-ui",
  "version": "0.0.1",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "test": "node --import ./ui/tools/register.mjs --test \"ui/**/*.test.ts\" \"theme/**/*.test.ts\" \"modules/**/*.test.ts\" \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node ui/tools/lint.mjs",
    "validate:manifests": "node --import ./ui/tools/register.mjs ui/tools/validate-manifests.ts",
    "licenses": "node ui/tools/check-licenses.mjs",
    "tokens": "node --import ./ui/tools/register.mjs theme/tokens/generate.ts",
    "check": "npm run typecheck && npm run lint && npm run validate:manifests && npm run licenses && npm test"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "ajv": "8.20.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "description": "Corvid WebUI chrome, layout engine, module host and theme engine (Phase 1)"
}
