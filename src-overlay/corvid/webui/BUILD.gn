# Evaluated by gn and built in M2.
# Pure policy (host table -> decision -> rewritten URL): depends only on //base and //url.
source_set("stock_page_policy") {
  sources = [
    "stock_page_policy.cc",
    "stock_page_policy.h",
    "stock_page_table.inc",
  ]
  deps = [
    "//base",
    "//url",
  ]
}

# BrowserURLHandler glue. Separate so the policy and its tests do not pull in //content.
source_set("stock_page_rewriter") {
  sources = [
    "stock_page_rewriter.cc",
    "stock_page_rewriter.h",
  ]
  deps = [
    ":stock_page_policy",
    "//content/public/browser",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "stock_page_policy_unittest.cc",
    "stock_page_rewriter_unittest.cc",
  ]
  deps = [
    ":stock_page_policy",
    ":stock_page_rewriter",
    "//base",
    "//testing/gtest",
    "//url",
  ]
}
