# Built in M2: mojom, ring_buffer (+ its gtest). Written for G4, UNBUILT: event_bus (+ stack_sampler), collectors
# (hang only), event_bus_unittest. Compile order: ring_buffer -> event_bus -> collectors -> unit_tests.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "diagnostics.mojom" ]
}

source_set("ring_buffer") {
  sources = [
    "ring_buffer.cc",
    "ring_buffer.h",
  ]
}

source_set("event_bus") {
  sources = [
    "event_bus.cc",
    "event_bus.h",
    "stack_sampler.cc",
    "stack_sampler.h",
  ]
  public_deps = [
    ":ring_buffer",
    "//base",
  ]
  deps = [ "//content/public/browser" ]
}

# net_collector.cc is a sketch (class declared in the .cc, OnAddEntry not written): kept out of the compile until
# it is finished (docs/notes/g4-spec.md, step: net events).
source_set("collectors") {
  sources = [
    "hang_collector.cc",
    "hang_collector.h",
  ]
  deps = [
    ":event_bus",
    ":mojom",
    ":ring_buffer",
    "//content/public/browser",
    "//net",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "event_bus_unittest.cc",
    "ring_buffer_unittest.cc",
  ]
  defines = [ "CORVID_GTEST" ]
  deps = [
    ":collectors",
    ":event_bus",
    ":ring_buffer",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
