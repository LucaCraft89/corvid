# Built in M2: mojom, ring_buffer (+ its gtest). Written for G4, UNBUILT: event_bus (+ stack_sampler), collectors
# (hang only), event_bus_unittest. Compile order: ring_buffer -> event_bus -> collectors -> unit_tests.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "diagnostics.mojom" ]
}

source_set("ring_buffer") {
  sources = [
    "ring_buffer.cc",
    "ring_buffer.h",
  ]
}

source_set("event_bus") {
  sources = [
    "event_bus.cc",
    "event_bus.h",
    "stack_sampler.cc",
    "stack_sampler.h",
  ]
  public_deps = [
    ":ring_buffer",
    "//base",
  ]
  deps = [ "//content/public/browser" ]
}

# net_collector.cc (NetLog observer sketch) was replaced by navigation_error_collector: the network stack runs in the
# network service process, so a browser-side NetLog observer would not see page requests.
source_set("service") {
  sources = [
    "diagnostics_service.cc",
    "diagnostics_service.h",
  ]
  public_deps = [
    ":event_bus",
    ":mojom",
  ]
  deps = [
    "//base",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("collectors") {
  sources = [
    "hang_collector.cc",
    "hang_collector.h",
    "navigation_error_collector.cc",
    "navigation_error_collector.h",
  ]
  deps = [
    ":event_bus",
    ":mojom",
    ":ring_buffer",
    "//content/public/browser",
    "//net",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "diagnostics_service_unittest.cc",
    "event_bus_unittest.cc",
    "navigation_error_collector_unittest.cc",
    "ring_buffer_unittest.cc",
  ]
  defines = [ "CORVID_GTEST" ]
  deps = [
    ":collectors",
    ":event_bus",
    ":ring_buffer",
    ":service",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
