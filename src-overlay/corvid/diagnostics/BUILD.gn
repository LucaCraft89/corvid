# Built in M2: mojom, ring_buffer (+ its gtest). NOT built yet: `collectors` (hang_collector.cc / net_collector.cc need
# event_bus.h and stack_sampler.h, which are Phase 2 work). The collectors target is kept so the intent is visible,
# but nothing depends on it.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "diagnostics.mojom" ]
}

source_set("ring_buffer") {
  sources = [
    "ring_buffer.cc",
    "ring_buffer.h",
  ]
}

source_set("collectors") {
  sources = [
    "hang_collector.cc",
    "hang_collector.h",
    "net_collector.cc",
  ]
  deps = [
    ":mojom",
    ":ring_buffer",
    "//content/public/browser",
    "//net",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "ring_buffer_unittest.cc" ]
  defines = [ "CORVID_GTEST" ]
  deps = [
    ":ring_buffer",
    "//testing/gtest",
  ]
}
