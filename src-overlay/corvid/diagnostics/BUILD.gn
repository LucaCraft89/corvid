import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "diagnostics.mojom" ]
}

source_set("ring_buffer") {
  sources = [ "ring_buffer.cc", "ring_buffer.h" ]
}

source_set("collectors") {
  sources = [ "hang_collector.cc", "hang_collector.h", "net_collector.cc" ]
  deps = [ ":mojom", ":ring_buffer", "//content/public/browser", "//net" ]
}

source_set("unittests") {
  testonly = true
  sources = [ "ring_buffer_unittest.cc" ]  # standalone main(); convert to gtest TEST() when wired
  deps = [ ":ring_buffer" ]
}
