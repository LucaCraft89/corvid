# Compiled and tested against Chromium 155 in M2 (docs/notes/chromium-api-m2.md).
source_set("extensions") {
  sources = [
    "ntp_override.cc",
    "ntp_override.h",
  ]
  deps = [ "//base" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "ntp_override_unittest.cc" ]
  deps = [
    ":extensions",
    "//base",
    "//testing/gtest",
  ]
}

source_set("preinstalled_loader") {
  sources = [
    "preinstalled_loader.cc",
    "preinstalled_loader.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/extensions:external_loader",
  ]
}
