# Corvid Android arm64 release. UNVERIFIED: never built (sandbox cannot build Chromium).
# Arg names must be checked with `gn args out/android-arm64-release --list` on the pinned tree.
# Decisions 2026-10-09: minSdk floor 26, target Android 12+; ABIs arm64+armhf ship (docs/specs/phase-5-budgets.md).

target_os = "android"
target_cpu = "arm64"

is_debug = false
is_official_build = true
is_component_build = false
symbol_level = 1
use_thin_lto = true
chrome_pgo_phase = 0            # enable once a profile for the pinned version exists

# --- de-Google (see skills/debrand-and-degoogle) ---
use_official_google_api_keys = false
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
safe_browsing_mode = 0
enable_reporting = false

# --- features not wanted on Android Corvid ---
enable_vr = false
enable_arcore = false
enable_cardboard = false
enable_openxr = false
# TODO verify names: Play-services dependent code must be off in the base build
# (e.g. `use_play_services` style args differ by milestone; grep build/config/android and chrome/android/BUILD.gn).

# --- extensions (Track B). UNVERIFIED arg name; see docs/notes/android-ext-baseline.md ---
enable_desktop_android_extensions = true
# Corvid overlay arg (defined in src-overlay/corvid/android/ext/BUILD.gn); false isolates Track B.
corvid_android_extensions = true

# proprietary_codecs / ffmpeg_branding: blocked on CR-3, intentionally unset.

# Build targets (verify in chrome/android/BUILD.gn): chrome_public_apk, chrome_public_bundle (AAB).
# Min SDK is taken from the pinned tree unless overridden by CR-A1.
