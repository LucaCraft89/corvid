# Corvid Windows x64 dev/debug GN args (fast iteration; component build).
# UNVERIFIED: not run through `gn gen`. See notes in win-release.gn.
target_os = "win"
target_cpu = "x64"

is_debug = true
is_component_build = true
symbol_level = 1
is_official_build = false
is_chrome_branded = false

google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
safe_browsing_mode = 0

use_goma = false
use_remoteexec = false
