+// Corvid: the "Keep uBlock Origin up to date" switch in chrome://preferences.
+void ExtensionService::OnUBlockUpdatesChanged() {
+  bool enabled =
+      corvid::extensions::UBlockUpdatesEnabled(*profile_->GetPrefs());
+  if (enabled == ublock_updates_enabled_ || !extension_registrar_) {
+    return;
+  }
+  ublock_updates_enabled_ = enabled;
+  // uBO reads its admin settings from its own cache first and refreshes the
+  // cache in the background: the second start sees the new value.
+  for (int seconds : {0, 5}) {
+    content::GetUIThreadTaskRunner({base::TaskPriority::BEST_EFFORT})
