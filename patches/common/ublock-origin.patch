+            base::BindOnce(&ExtensionRegistrar::ReloadExtension,
+                           extension_registrar_->GetWeakPtr(),
+                           corvid::extensions::kUBlockOriginId),
+            base::Seconds(seconds));
+  }
+  if (enabled && updater_ && updater_->enabled()) {
+    updater_->CheckNow(ExtensionUpdater::CheckParams());
+  }
