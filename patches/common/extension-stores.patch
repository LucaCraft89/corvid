+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#ifndef COMPONENTS_CORVID_EXTENSIONS_SOURCES_H_
+#define COMPONENTS_CORVID_EXTENSIONS_SOURCES_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/component_export.h"
+#include "url/gurl.h"
+
+class PrefService;
+
+// Where extensions may come from. The settings live in the "extensions" part
+// of the profile pref the Corvid pages write (chrome://preferences):
+//   { "chromeWebStore": bool, "edgeAddons": bool,
+//     "customStores": [ { "name": str, "updateUrl": "https://..." } ],
+//     "ublockUpdates": bool }
+namespace corvid::extensions {
+
+// Same pref as corvid::kWebUIPrefs (chrome/browser/ui/webui/corvid).
+inline constexpr char kWebUIPrefs[] = "corvid.webui_prefs";
+
+inline constexpr char kChromeWebStoreUpdateUrl[] =
+    "https://clients2.google.com/service/update2/crx";
+inline constexpr char kEdgeAddonsUpdateUrl[] =
+    "https://edge.microsoft.com/extensionwebstorebase/v1/crx";
+
+struct Store {
+  std::string name;
+  GURL update_url;
+  bool enabled = true;
+};
+
+// Chrome Web Store, Edge Add-ons, then the user's own stores.
+COMPONENT_EXPORT(CORVID_EXTENSIONS)
+std::vector<Store> GetStores(const PrefService& prefs);
+
+COMPONENT_EXPORT(CORVID_EXTENSIONS)
+bool IsChromeWebStoreEnabled(const PrefService& prefs);
+
+// False when `update_url` is the update service of a store the user turned
+// off. Unknown update URLs (self-hosted extensions) are allowed.
+COMPONENT_EXPORT(CORVID_EXTENSIONS)
+bool IsUpdateUrlAllowed(const PrefService& prefs, const GURL& update_url);
+
+// For a download from the update service of an enabled store
+// (".../crx?response=redirect&x=id%3D<id>%26..."): the extension id it asks
+// for. Nothing for any other URL.
+COMPONENT_EXPORT(CORVID_EXTENSIONS)
+std::optional<std::string> GetStoreDownloadId(const PrefService& prefs,
+                                              const GURL& url);
+
+}  // namespace corvid::extensions
+
+#endif  // COMPONENTS_CORVID_EXTENSIONS_SOURCES_H_
