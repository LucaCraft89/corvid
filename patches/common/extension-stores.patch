@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#include "components/corvid_extensions/sources.h"
+
+#include <string_view>
+
+#include "base/strings/string_split.h"
+#include "base/values.h"
+#include "components/prefs/pref_service.h"
+#include "net/base/url_util.h"
+
+namespace corvid::extensions {
+
+namespace {
+
+constexpr size_t kMaxCustomStores = 20;
+
+const base::DictValue* Settings(const PrefService& prefs) {
+  if (!prefs.FindPreference(kWebUIPrefs)) {
+    return nullptr;
+  }
+  return prefs.GetDict(kWebUIPrefs).FindDict("extensions");
+}
+
+bool GetBool(const base::DictValue* settings, std::string_view key) {
+  return !settings || settings->FindBool(key).value_or(true);
+}
+
+// Same service: scheme, host, port and path (the query differs per request).
+bool SameService(const GURL& a, const GURL& b) {
+  return a.is_valid() && b.is_valid() && a.scheme() == b.scheme() &&
+         a.host() == b.host() && a.EffectiveIntPort() == b.EffectiveIntPort() &&
+         a.path() == b.path();
+}
+
+const Store* FindStore(const std::vector<Store>& stores, const GURL& url) {
+  for (const Store& store : stores) {
+    if (SameService(store.update_url, url)) {
+      return &store;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+std::vector<Store> GetStores(const PrefService& prefs) {
+  const base::DictValue* settings = Settings(prefs);
+  std::vector<Store> stores = {
+      {"Chrome Web Store", GURL(kChromeWebStoreUpdateUrl),
+       GetBool(settings, "chromeWebStore")},
+      {"Microsoft Edge Add-ons", GURL(kEdgeAddonsUpdateUrl),
+       GetBool(settings, "edgeAddons")},
+  };
+  const base::ListValue* custom =
+      settings ? settings->FindList("customStores") : nullptr;
+  if (!custom) {
+    return stores;
+  }
+  for (const base::Value& entry : *custom) {
+    if (stores.size() >= 2 + kMaxCustomStores || !entry.is_dict()) {
+      continue;
+    }
+    const std::string* name = entry.GetDict().FindString("name");
+    const std::string* url = entry.GetDict().FindString("updateUrl");
+    GURL update_url(url ? *url : std::string());
+    if (!name || !update_url.is_valid() ||
+        !update_url.SchemeIs(url::kHttpsScheme)) {
+      continue;
+    }
+    stores.push_back({*name, update_url, true});
+  }
+  return stores;
+}
+
+bool IsChromeWebStoreEnabled(const PrefService& prefs) {
+  return GetBool(Settings(prefs), "chromeWebStore");
+}
+
+bool IsUpdateUrlAllowed(const PrefService& prefs, const GURL& update_url) {
+  std::vector<Store> stores = GetStores(prefs);
+  const Store* store = FindStore(stores, update_url);
+  return !store || store->enabled;
+}
+
+std::optional<std::string> GetStoreDownloadId(const PrefService& prefs,
+                                              const GURL& url) {
+  std::vector<Store> stores = GetStores(prefs);
+  const Store* store = FindStore(stores, url);
+  if (!store || !store->enabled) {
+    return std::nullopt;
+  }
+  // x=id%3D<id>%26installsource%3Dondemand%26uc (GetValueForKeyInQuery
+  // unescapes it once).
+  std::string x;
+  if (!net::GetValueForKeyInQuery(url, "x", &x)) {
+    return std::nullopt;
+  }
+  for (const auto& part : base::SplitStringPiece(
+           x, "&", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (part.size() == 35 && part.starts_with("id=")) {
+      std::string id(part.substr(3));
+      for (char c : id) {
+        if (c < 'a' || c > 'p') {
+          return std::nullopt;
+        }
+      }
+      return id;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace corvid::extensions
