+
+TEST(CorvidSyncRoster, RoundTrip) {
+  Roster roster;
+  roster.version = 7;
+  roster.devices.push_back(RosterEntry{"dev_1", "A \"quoted\" name", Key{1},
+                                       "dev_1", false});
+  roster.devices.push_back(RosterEntry{"dev_2", "B", Key{2}, "dev_1", true});
+  auto parsed = Roster::FromJson(roster.ToJson());
+  ASSERT_TRUE(parsed);
+  EXPECT_EQ(*parsed, roster);
+  EXPECT_TRUE(parsed->IsActive("dev_1"));
+  EXPECT_FALSE(parsed->IsActive("dev_2"));
+  EXPECT_FALSE(parsed->IsActive("dev_3"));
+}
+
+TEST(CorvidSyncRoster, ReadsGoJson) {
+  // Go: empty slice in the test vector, null for a nil slice.
+  auto empty = Roster::FromJson(R"({"version":1,"devices":[]})");
+  ASSERT_TRUE(empty);
+  EXPECT_EQ(empty->version, 1u);
+  EXPECT_TRUE(Roster::FromJson(R"({"version":0,"devices":null})"));
+}
+
+TEST(CorvidSyncRoster, RejectsMalformed) {
+  EXPECT_FALSE(Roster::FromJson("not json"));
+  EXPECT_FALSE(Roster::FromJson("{}"));
+  EXPECT_FALSE(Roster::FromJson(R"({"version":-1,"devices":[]})"));
+  EXPECT_FALSE(Roster::FromJson(R"({"version":1,"devices":[{"name":"x"}]})"));
+  EXPECT_FALSE(Roster::FromJson(
+      R"({"version":1,"devices":[{"device_id":"a","public_key":"AAAA"}]})"));
+}
