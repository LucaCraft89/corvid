+#include "components/corvid_sync/api_client.h"
+
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/types/expected_macros.h"
+#include "net/base/ip_address.h"
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+
+namespace corvid_sync {
+
+namespace {
+
+std::optional<base::DictValue> ParseDict(const std::string& body) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(body, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*value).TakeDict();
+}
+
+ApiError BadResponse() {
+  return ApiError{.kind = ApiError::Kind::kBadResponse};
+}
+
+std::string Str(const base::DictValue& d, std::string_view key) {
+  const std::string* s = d.FindString(key);
+  return s ? *s : std::string();
+}
+
+int64_t Int(const base::DictValue& d, std::string_view key) {
+  const base::Value* v = d.Find(key);
+  if (!v) {
+    return 0;
+  }
+  if (v->is_int()) {
+    return v->GetInt();
+  }
+  if (v->is_double()) {
+    return static_cast<int64_t>(v->GetDouble());
+  }
+  return 0;
+}
+
+std::string Escape(std::string_view s) {
+  return base::EscapePath(s);
+}
+
+}  // namespace
+
+std::string ApiErrorText(const ApiError& error) {
+  switch (error.kind) {
+    case ApiError::Kind::kNetwork:
+      return "Cannot reach the sync server.";
+    case ApiError::Kind::kAborted:
+      return "Cancelled.";
+    case ApiError::Kind::kUnauthorized:
+      return "The server does not know this device.";
+    case ApiError::Kind::kRevoked:
+      return "This device was removed from the account.";
+    case ApiError::Kind::kTokenInvalid:
+      return "The code was already used, has expired or is wrong.";
+    case ApiError::Kind::kNotFound:
+    case ApiError::Kind::kNoObject:
+      return "Not found on the server.";
+    case ApiError::Kind::kConflict:
+      return "Changed on the server at the same time; try again.";
+    case ApiError::Kind::kTooLarge:
+      return "Too large for the server.";
+    case ApiError::Kind::kQuota:
+      return "The account is full on the server.";
+    case ApiError::Kind::kServer:
+      return base::StringPrintf("The server answered %d %s.", error.status,
+                                error.code.c_str());
+    case ApiError::Kind::kBadResponse:
+      return "The server's answer could not be read.";
+  }
+  return std::string();
+}
+
+std::string NormalizeServerUrl(std::string_view url) {
+  GURL gurl(base::TrimWhitespaceASCII(url, base::TRIM_ALL));
+  if (!gurl.is_valid() || gurl.has_query() || gurl.has_ref() ||
+      gurl.has_username() || gurl.has_password()) {
+    return std::string();
+  }
+  if (gurl.SchemeIs("http")) {
+    if (!net::IsLocalhost(gurl)) {
+      return std::string();
+    }
+  } else if (!gurl.SchemeIs("https")) {
+    return std::string();
+  }
+  std::string out = gurl.spec();
+  while (base::EndsWith(out, "/")) {
+    out.pop_back();
+  }
+  return out;
+}
+
+ApiClient::ApiClient(BlockingHttp* http,
+                     std::string server_url,
+                     std::string secret)
+    : http_(http),
+      server_url_(NormalizeServerUrl(server_url)),
+      secret_(std::move(secret)) {}
+
+ApiClient::~ApiClient() = default;
+
+ApiClient::Result<HttpResponse> ApiClient::Do(
+    std::string method,
+    std::string path,
+    std::string body,
+    std::string content_type,
+    std::vector<std::pair<std::string, std::string>> headers) {
+  if (server_url_.empty()) {
+    return base::unexpected(ApiError{.kind = ApiError::Kind::kNetwork,
+                                     .message = "invalid server address"});
+  }
+  HttpRequest request;
+  request.method = std::move(method);
+  request.url = server_url_ + path;
+  request.body = std::move(body);
+  request.content_type = std::move(content_type);
+  request.headers = std::move(headers);
+  if (!secret_.empty()) {
+    request.headers.emplace_back("Authorization", "Bearer " + secret_);
+  }
+  HttpResponse response = http_->Send(request);
+  if (response.aborted) {
+    return base::unexpected(ApiError{.kind = ApiError::Kind::kAborted});
+  }
+  if (response.status == 0) {
+    return base::unexpected(ApiError{.kind = ApiError::Kind::kNetwork});
+  }
+  if (response.status >= 200 && response.status < 300) {
+    return response;
+  }
+  ApiError error;
+  error.status = response.status;
+  if (std::optional<base::DictValue> d = ParseDict(response.body)) {
+    error.code = Str(*d, "error");
+    error.message = Str(*d, "message");
+  }
+  if (error.code == "device_revoked") {
+    error.kind = ApiError::Kind::kRevoked;
+  } else if (response.status == 401) {
+    error.kind = ApiError::Kind::kUnauthorized;
+  } else if (response.status == 403 && error.code == "token_invalid") {
+    error.kind = ApiError::Kind::kTokenInvalid;
+  } else if (response.status == 404) {
+    error.kind = error.code == "no_object" ? ApiError::Kind::kNoObject
+                                           : ApiError::Kind::kNotFound;
+  } else if (response.status == 412) {
+    error.kind = ApiError::Kind::kConflict;
+  } else if (response.status == 413) {
+    error.kind = ApiError::Kind::kTooLarge;
+  } else if (response.status == 507) {
+    error.kind = ApiError::Kind::kQuota;
+  } else {
+    error.kind = ApiError::Kind::kServer;
+  }
+  return base::unexpected(std::move(error));
+}
+
+ApiClient::Result<HttpResponse> ApiClient::DoJson(std::string method,
+                                                  std::string path,
+                                                  const base::DictValue* body) {
+  if (!body) {
+    return Do(std::move(method), std::move(path));
+  }
+  return Do(std::move(method), std::move(path),
+            base::WriteJson(*body).value_or("{}"), "application/json");
+}
+
+ApiClient::Status ApiClient::Health() {
+  ASSIGN_OR_RETURN(HttpResponse r, DoJson("GET", "/v1/health", nullptr));
+  std::optional<base::DictValue> d = ParseDict(r.body);
+  if (!d || Str(*d, "status") != "ok") {
+    return base::unexpected(BadResponse());
+  }
+  return base::ok();
+}
+
+ApiClient::Result<Registration> ApiClient::Register(std::string_view token,
+                                                    std::string_view name,
+                                                    const Key& public_key) {
+  base::DictValue body;
+  body.Set("token", token);
+  body.Set("name", name);
+  body.Set("public_key", Base64(public_key));
+  ASSIGN_OR_RETURN(HttpResponse r, DoJson("POST", "/v1/register", &body));
+  std::optional<base::DictValue> d = ParseDict(r.body);
+  if (!d) {
+    return base::unexpected(BadResponse());
+  }
+  Registration reg{Str(*d, "account"), Str(*d, "device_id"),
+                   Str(*d, "device_secret")};
+  if (reg.device_id.empty() || reg.device_secret.empty()) {
+    return base::unexpected(BadResponse());
+  }
+  return reg;
+}
+
+ApiClient::Result<std::vector<DeviceInfo>> ApiClient::Devices() {
+  ASSIGN_OR_RETURN(HttpResponse r, DoJson("GET", "/v1/devices", nullptr));
+  std::optional<base::DictValue> d = ParseDict(r.body);
+  const base::ListValue* list = d ? d->FindList("devices") : nullptr;
+  if (!list) {
+    return base::unexpected(BadResponse());
+  }
+  std::vector<DeviceInfo> out;
+  for (const base::Value& v : *list) {
+    if (!v.is_dict()) {
+      return base::unexpected(BadResponse());
+    }
+    const base::DictValue& e = v.GetDict();
+    std::optional<Key> pub = KeyFromBase64(Str(e, "public_key"));
+    if (!pub) {
+      return base::unexpected(BadResponse());
+    }
+    out.push_back(DeviceInfo{Str(e, "id"), Str(e, "name"), *pub,
+                             Int(e, "created"), Int(e, "last_seen"),
+                             e.Find("revoked") != nullptr &&
+                                 !e.Find("revoked")->is_none()});
+  }
+  return out;
+}
+
+ApiClient::Status ApiClient::RevokeDevice(std::string_view id) {
+  RETURN_IF_ERROR(DoJson("DELETE", "/v1/devices/" + Escape(id), nullptr));
+  return base::ok();
+}
+
+ApiClient::Result<std::string> ApiClient::CreateInvite(int64_t ttl_seconds) {
+  base::DictValue body;
+  body.Set("ttl_seconds", static_cast<int>(ttl_seconds));
+  ASSIGN_OR_RETURN(HttpResponse r, DoJson("POST", "/v1/invites", &body));
+  std::optional<base::DictValue> d = ParseDict(r.body);
+  std::string token = d ? Str(*d, "token") : std::string();
+  if (token.empty()) {
+    return base::unexpected(BadResponse());
+  }
+  return token;
+}
+
+ApiClient::Result<std::vector<VaultInfo>> ApiClient::Vaults() {
+  ASSIGN_OR_RETURN(HttpResponse r, DoJson("GET", "/v1/vaults", nullptr));
+  std::optional<base::DictValue> d = ParseDict(r.body);
+  const base::ListValue* list = d ? d->FindList("vaults") : nullptr;
+  if (!list) {
+    return base::unexpected(BadResponse());
+  }
+  std::vector<VaultInfo> out;
+  for (const base::Value& v : *list) {
+    if (v.is_dict()) {
+      out.push_back(VaultInfo{Str(v.GetDict(), "vault_uuid"),
+                              Str(v.GetDict(), "display_name")});
+    }
+  }
+  return out;
+}
+
+ApiClient::Status ApiClient::PutVault(std::string_view uuid,
+                                      std::string_view display_name) {
+  base::DictValue body;
+  body.Set("display_name", display_name);
+  RETURN_IF_ERROR(DoJson("PUT", "/v1/vaults/" + Escape(uuid), &body));
+  return base::ok();
+}
+
+ApiClient::Status ApiClient::DeleteVault(std::string_view uuid) {
+  RETURN_IF_ERROR(DoJson("DELETE", "/v1/vaults/" + Escape(uuid), nullptr));
+  return base::ok();
+}
+
+ApiClient::Result<std::optional<StoredObject>> ApiClient::ReadObject(
+    std::string_view uuid,
+    std::string_view id,
+    size_t max_bytes) {
+  Result<HttpResponse> r =
+      Do("GET", base::StringPrintf("/v1/vaults/%s/objects/%s?max_bytes=%zu",
+                                   Escape(uuid).c_str(), Escape(id).c_str(),
+                                   max_bytes));
+  if (!r.has_value()) {
+    if (r.error().kind == ApiError::Kind::kNoObject) {
+      return std::nullopt;
+    }
+    return base::unexpected(r.error());
+  }
+  if (r->etag.empty() || r->body.size() > max_bytes) {
+    return base::unexpected(BadResponse());
+  }
+  return StoredObject{std::vector<uint8_t>(r->body.begin(), r->body.end()),
+                      r->etag};
+}
+
+ApiClient::Result<std::string> ApiClient::WriteObject(
+    std::string_view uuid,
+    std::string_view id,
+    const std::optional<std::string>& expected,
+    const std::vector<uint8_t>& data,
+    std::optional<uint32_t> retention_epoch) {
+  std::vector<std::pair<std::string, std::string>> headers;
+  if (expected) {
+    headers.emplace_back("If-Match", "\"" + *expected + "\"");
+  } else {
+    headers.emplace_back("If-None-Match", "*");
+  }
+  if (retention_epoch) {
+    headers.emplace_back("X-Retention-Epoch",
+                         base::NumberToString(*retention_epoch));
+  }
+  ASSIGN_OR_RETURN(
+      HttpResponse r,
+      Do("PUT",
+         base::StringPrintf("/v1/vaults/%s/objects/%s", Escape(uuid).c_str(),
+                            Escape(id).c_str()),
+         std::string(data.begin(), data.end()), "application/octet-stream",
+         std::move(headers)));
+  if (r.etag.empty()) {
+    return base::unexpected(BadResponse());
+  }
+  return r.etag;
+}
+
+ApiClient::Status ApiClient::Collect(std::string_view uuid,
+                                     uint32_t minimum_retained_epoch) {
+  base::DictValue body;
+  body.Set("minimum_retained_epoch", static_cast<int>(minimum_retained_epoch));
+  RETURN_IF_ERROR(DoJson("POST", "/v1/vaults/" + Escape(uuid) + "/collect", &body));
+  return base::ok();
+}
+
+ApiClient::Status ApiClient::PostMessage(std::string_view to,
+                                         std::string_view kind,
+                                         base::span<const uint8_t> data) {
+  base::DictValue body;
+  body.Set("to_device", to);
+  body.Set("kind", kind);
+  body.Set("data", Base64(data));
+  RETURN_IF_ERROR(DoJson("POST", "/v1/messages", &body));
+  return base::ok();
+}
+
+ApiClient::Result<std::vector<Message>> ApiClient::Messages() {
+  ASSIGN_OR_RETURN(HttpResponse r, DoJson("GET", "/v1/messages", nullptr));
+  std::optional<base::DictValue> d = ParseDict(r.body);
+  if (!d) {
+    return base::unexpected(BadResponse());
+  }
+  std::vector<Message> out;
+  const base::ListValue* list = d->FindList("messages");
+  if (!list) {
+    return out;  // Go encodes an empty slice as null.
+  }
+  for (const base::Value& v : *list) {
+    if (!v.is_dict()) {
+      continue;
+    }
+    const base::DictValue& e = v.GetDict();
+    std::optional<std::vector<uint8_t>> data = FromBase64(Str(e, "data"));
+    out.push_back(Message{Int(e, "id"), Str(e, "from_device"), Str(e, "kind"),
+                          data ? std::move(*data) : std::vector<uint8_t>()});
+  }
+  return out;
+}
+
+ApiClient::Status ApiClient::DeleteMessage(int64_t id) {
+  RETURN_IF_ERROR(DoJson("DELETE", "/v1/messages/" + base::NumberToString(id), nullptr));
+  return base::ok();
+}
+
+}  // namespace corvid_sync
