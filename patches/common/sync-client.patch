+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#ifndef COMPONENTS_CORVID_SYNC_KEYS_H_
+#define COMPONENTS_CORVID_SYNC_KEYS_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+// Corvid's additions to Helium's vault format (sync/protocol/SPEC.md,
+// section 4): device identity keys, pairing proof and comparison code, key
+// envelopes, the recovery key and the encrypted roster object. Test vectors:
+// sync/protocol/vectors-pairing.json and vectors-vault.json.
+namespace corvid_sync {
+
+inline constexpr size_t kKeySize = 32;
+using Key = std::array<uint8_t, kKeySize>;
+
+inline constexpr char kKindPairRequest[] = "pair-request";
+inline constexpr char kKindVaultKey[] = "vault-key";
+inline constexpr char kKindVaultRotate[] = "vault-rotate";
+
+// X25519 identity key of this device.
+Key NewPrivateKey();
+Key PublicKeyFor(const Key& private_key);
+
+Key RandomKey();
+// Random version 4 UUID, lowercase.
+std::string NewVaultUuid();
+bool IsValidUuid(std::string_view uuid);
+
+// HMAC-SHA256(pair_secret, "corvid-sync-v1/pair-request" || new_pub).
+Key PairProof(base::span<const uint8_t> pair_secret,
+              base::span<const uint8_t> new_public);
+
+// Six digits both devices show while pairing.
+std::string ComparisonCode(base::span<const uint8_t> pair_secret,
+                           base::span<const uint8_t> approver_public,
+                           base::span<const uint8_t> new_public);
+
+// Salt of a vault-rotate envelope; proves knowledge of the old key.
+Key RotationSalt(base::span<const uint8_t> old_vault_key,
+                 std::string_view old_vault_uuid);
+
+// What a key envelope carries.
+struct VaultGrant {
+  std::string vault_uuid;
+  Key vault_key{};
+  std::string display_name;
+  std::string replaces_uuid;  // Set on rotation.
+
+  bool operator==(const VaultGrant&) const = default;
+};
+
+// nonce(12) || AES-256-GCM(k, nonce, JSON grant, "corvid-sync-v1/envelope/"
+// kind). `nonce` is random unless a test passes one.
+std::vector<uint8_t> SealEnvelope(
+    const Key& sender_private,
+    const Key& recipient_public,
+    base::span<const uint8_t> salt,
+    std::string_view kind,
+    const VaultGrant& grant,
+    std::optional<std::array<uint8_t, 12>> nonce = std::nullopt);
+
+// nullopt when the envelope does not authenticate or is malformed.
+std::optional<VaultGrant> OpenEnvelope(const Key& recipient_private,
+                                       const Key& sender_public,
+                                       base::span<const uint8_t> salt,
+                                       std::string_view kind,
+                                       base::span<const uint8_t> envelope);
+
+// "CVK1-" + base32(key || SHA-256(key)[0:2]) in groups of 5.
+std::string EncodeRecoveryKey(const Key& vault_key);
+// Tolerates case, spaces, missing dashes and 0/1/8 for O/I/B. nullopt on a
+// typo (checksum) or bad length.
+std::optional<Key> DecodeRecoveryKey(std::string_view text);
+
+// Encryption of Corvid's own vault objects (the roster, role 16), the same
+// container as Helium's head: nonce || AES-256-GCM-SIV(object key, ...).
+class ObjectCrypto {
+ public:
+  static constexpr uint8_t kRoleRoster = 16;
+
+  ObjectCrypto(const Key& vault_key, std::string vault_uuid);
+  ~ObjectCrypto();
+
+  std::vector<uint8_t> Encrypt(
+      uint8_t role,
+      base::span<const uint8_t> plaintext,
+      std::optional<std::array<uint8_t, 12>> nonce = std::nullopt) const;
+  std::optional<std::vector<uint8_t>> Decrypt(
+      uint8_t role,
+      base::span<const uint8_t> container) const;
+
+ private:
+  std::vector<uint8_t> AssociatedData(uint8_t role) const;
+
+  Key object_key_;
+  std::string vault_uuid_;
+};
+
+// base64 helpers for the server's JSON ([]byte fields in Go = std base64).
+std::string Base64(base::span<const uint8_t> data);
+std::optional<std::vector<uint8_t>> FromBase64(std::string_view text);
+std::optional<Key> KeyFromBase64(std::string_view text);
+
+}  // namespace corvid_sync
+
+#endif  // COMPONENTS_CORVID_SYNC_KEYS_H_
