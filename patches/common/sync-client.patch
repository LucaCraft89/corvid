+// Copyright (C) 2026 Corvid contributors
+
+#include "components/corvid_sync/http.h"
+
+#include <optional>
+
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted.h"
+#include "base/notreached.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/cpp/simple_url_loader_stream_consumer.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace corvid_sync {
+
+namespace {
+
+constexpr base::TimeDelta kTimeout = base::Minutes(2);
+// Largest object (16 MiB) plus room for the JSON around it.
+constexpr size_t kMaxBody = 17 * 1024 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("corvid_sync", R"(
+      semantics {
+        sender: "Corvid sync"
+        description:
+          "Reads and writes the user's end-to-end encrypted sync vault and "
+          "device list on the sync server the user set up."
+        trigger: "Sync is set up on corvid://sync."
+        data:
+          "Encrypted vault objects, this device's name and public key, and "
+          "a per-device secret for the server."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Turn sync off on corvid://sync."
+        policy_exception_justification: "Not implemented."
+      })");
+
+}  // namespace
+
+// Allowed to wait on the sync thread and the account worker, like HttpBridge
+// (base/threading/thread_restrictions.h).
+class HttpWait {
+ public:
+  static void Wait(base::WaitableEvent& event) {
+    base::ScopedAllowBaseSyncPrimitives allow_wait;
+    event.Wait();
+  }
+};
+
+// Lives on the network sequence; the waiting side only touches the state
+// under the lock.
+class UrlLoaderBlockingHttp::Core
+    : public base::RefCountedThreadSafe<UrlLoaderBlockingHttp::Core>,
+      public network::SimpleURLLoaderStreamConsumer {
+ public:
+  explicit Core(
+      std::unique_ptr<network::PendingSharedURLLoaderFactory> pending_factory)
+      : pending_factory_(std::move(pending_factory)) {}
+
+  // Called on the waiting sequence. Returns false when aborted.
+  HttpResponse Run(scoped_refptr<base::SequencedTaskRunner> runner,
+                   const HttpRequest& request) {
+    {
+      base::AutoLock lock(lock_);
+      if (aborted_) {
+        return HttpResponse{.aborted = true};
+      }
+      done_ = false;
+      response_ = HttpResponse();
+      event_.Reset();
+    }
+    runner->PostTask(FROM_HERE,
+                     base::BindOnce(&Core::Start, this, request));
+    HttpWait::Wait(event_);
+    base::AutoLock lock(lock_);
+    if (aborted_) {
+      return HttpResponse{.aborted = true};
+    }
+    return std::move(response_);
+  }
+
+  void Abort(scoped_refptr<base::SequencedTaskRunner> runner) {
+    {
+      base::AutoLock lock(lock_);
+      aborted_ = true;
+    }
+    event_.Signal();
+    runner->PostTask(FROM_HERE, base::BindOnce(&Core::Reset, this));
+  }
+
+  void Shutdown(scoped_refptr<base::SequencedTaskRunner> runner) {
+    runner->PostTask(FROM_HERE, base::BindOnce(&Core::Reset, this));
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<Core>;
+  ~Core() override = default;
+
+  void Start(HttpRequest request) {
+    if (!factory_ && pending_factory_) {
+      factory_ = network::SharedURLLoaderFactory::Create(
+          std::move(pending_factory_));
+    }
+    {
+      base::AutoLock lock(lock_);
+      if (aborted_ || !factory_) {
+        Finish(HttpResponse());
+        return;
+      }
+    }
+    auto resource = std::make_unique<network::ResourceRequest>();
+    resource->url = GURL(request.url);
+    resource->method = request.method;
+    resource->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    resource->load_flags = net::LOAD_DISABLE_CACHE;
+    for (const auto& [name, value] : request.headers) {
+      resource->headers.SetHeader(name, value);
+    }
+    loader_ = network::SimpleURLLoader::Create(std::move(resource),
+                                               kAnnotation);
+    if (request.method == "PUT" || request.method == "POST") {
+      loader_->AttachStringForUpload(
+          request.body, request.content_type.empty()
+                            ? "application/octet-stream"
+                            : request.content_type);
+    }
+    loader_->SetAllowHttpErrorResults(true);
+    loader_->SetTimeoutDuration(kTimeout);
+    // Streamed so the limit holds for an untrusted server (DownloadToString
+    // stops at 5 MiB, smaller than the largest object).
+    body_.clear();
+    loader_->DownloadAsStream(factory_.get(), this);
+  }
+
+  // network::SimpleURLLoaderStreamConsumer:
+  void OnDataReceived(std::string_view data,
+                      base::OnceClosure resume) override {
+    if (body_.size() + data.size() > kMaxBody) {
+      loader_.reset();
+      body_.clear();
+      base::AutoLock lock(lock_);
+      Finish(HttpResponse());
+      return;
+    }
+    body_.append(data);
+    std::move(resume).Run();
+  }
+
+  void OnRetry(base::OnceClosure start_retry) override {
+    NOTREACHED();  // No retry options are set.
+  }
+
+  void OnComplete(bool success) override {
+    HttpResponse response;
+    const network::mojom::URLResponseHead* head = loader_->ResponseInfo();
+    if (head && head->headers) {
+      response.status = head->headers->response_code();
+      std::optional<std::string> etag = head->headers->GetNormalizedHeader("ETag");
+      if (etag) {
+        response.etag = std::string(base::TrimString(*etag, "\"",
+                                                     base::TRIM_ALL));
+      }
+    }
+    if (success) {
+      response.body = std::move(body_);
+    } else {
+      response.status = 0;  // Network error.
+    }
+    body_.clear();
+    loader_.reset();
+    base::AutoLock lock(lock_);
+    Finish(std::move(response));
+  }
+
+  void Finish(HttpResponse response) EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+    response_ = std::move(response);
+    done_ = true;
+    event_.Signal();
+  }
+
+  void Reset() {
+    loader_.reset();
+    factory_.reset();
+  }
+
+  std::unique_ptr<network::PendingSharedURLLoaderFactory> pending_factory_;
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  std::string body_;
+
+  base::Lock lock_;
+  bool aborted_ GUARDED_BY(lock_) = false;
+  bool done_ GUARDED_BY(lock_) = false;
+  HttpResponse response_ GUARDED_BY(lock_);
+  base::WaitableEvent event_{base::WaitableEvent::ResetPolicy::MANUAL,
+                             base::WaitableEvent::InitialState::NOT_SIGNALED};
+};
+
+UrlLoaderBlockingHttp::UrlLoaderBlockingHttp(
+    std::unique_ptr<network::PendingSharedURLLoaderFactory> pending_factory)
+    : network_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE})),
+      core_(base::MakeRefCounted<Core>(std::move(pending_factory))) {}
+
+UrlLoaderBlockingHttp::~UrlLoaderBlockingHttp() {
+  core_->Shutdown(network_runner_);
+}
+
+HttpResponse UrlLoaderBlockingHttp::Send(const HttpRequest& request) {
+  // The signal takes one handler at a time and other sync code uses it too, so
+  // hold it only for the duration of a request.
+  if (signal_ && !signal_->TryRegisterHandler(this)) {
+    return HttpResponse{.aborted = true};
+  }
+  HttpResponse response = core_->Run(network_runner_, request);
+  if (signal_) {
+    signal_->UnregisterHandler(this);
+  }
+  return response;
+}
+
+void UrlLoaderBlockingHttp::SetCancelationSignal(
+    syncer::CancelationSignal* signal) {
+  signal_ = signal;
+}
+
+void UrlLoaderBlockingHttp::OnCancelationSignalReceived() {
+  core_->Abort(network_runner_);
+}
+
+}  // namespace corvid_sync
