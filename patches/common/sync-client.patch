+                        size_t maximum_bytes) override;
+  WriteResult WriteObject(const std::string& object_id,
+                          std::optional<std::string> expected_revision,
+                          std::vector<uint8_t> data,
+                          std::optional<uint32_t> retention_epoch) override;
+  void CollectEpochsBefore(uint32_t minimum_retained_epoch,
+                           CollectCallback callback) override;
+
+ private:
+  std::unique_ptr<BlockingHttp> http_;
+  ApiClient api_;
+  const std::string vault_uuid_;
+};
+
+}  // namespace corvid_sync
+
