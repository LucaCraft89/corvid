+
+std::string TestServer::AddToken() {
+  std::string token = "tok" + base::NumberToString(next_++);
+  tokens.insert(token);
+  return token;
+}
+
+HttpResponse TestServer::Send(const HttpRequest& request) {
+  request_count++;
+  if (offline) {
+    return HttpResponse();
+  }
+  return Handle(request);
+}
+
+HttpResponse TestServer::Handle(const HttpRequest& request) {
+  std::string path = request.url.substr(strlen(kTestServerUrl));
+  std::string query;
+  if (size_t q = path.find('?'); q != std::string::npos) {
+    query = path.substr(q + 1);
+    path = path.substr(0, q);
+  }
+  const std::vector<std::string> p = base::SplitString(
+      path, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  const std::string& m = request.method;
+  std::optional<base::Value> json =
+      base::JSONReader::Read(request.body, base::JSON_PARSE_RFC);
+  const base::DictValue* body =
+      json && json->is_dict() ? &json->GetDict() : nullptr;
+
+  if (m == "GET" && p == std::vector<std::string>{"v1", "health"}) {
+    base::DictValue d;
+    d.Set("status", "ok");
+    return Json(200, d);
+  }
+  if (m == "POST" && p == std::vector<std::string>{"v1", "register"}) {
+    const std::string* token = body ? body->FindString("token") : nullptr;
+    if (!token || !tokens.erase(*token)) {
+      return Error(403, "token_invalid");
+    }
+    const std::string id = "dev_" + base::NumberToString(next_++);
+    const std::string secret = "secret" + base::NumberToString(next_++);
+    devices[id] = Device{*body->FindString("name"),
+                         *body->FindString("public_key"), secret};
+    base::DictValue d;
+    d.Set("account", "acct");
+    d.Set("device_id", id);
+    d.Set("device_secret", secret);
+    return Json(201, d);
+  }
+
+  // The rest needs a device.
+  std::string self;
+  const std::string auth = Header(request, "Authorization");
+  for (const auto& [id, device] : devices) {
+    if (auth == "Bearer " + device.secret) {
+      self = id;
+    }
+  }
+  if (self.empty()) {
+    return Error(401, "unauthorized");
+  }
+  if (devices[self].revoked) {
+    return Error(401, "device_revoked");
+  }
+
+  if (p.size() >= 2 && p[1] == "devices") {
+    if (m == "GET") {
+      base::ListValue list;
+      for (const auto& [id, device] : devices) {
+        base::DictValue d;
+        d.Set("id", id);
+        d.Set("name", device.name);
+        d.Set("public_key", device.public_key);
+        d.Set("created", 1);
+        d.Set("last_seen", 2);
+        if (device.revoked) {
+          d.Set("revoked", 3);
+        }
+        list.Append(std::move(d));
+      }
+      base::DictValue d;
+      d.Set("devices", std::move(list));
+      return Json(200, d);
+    }
+    if (m == "DELETE" && p.size() == 3) {
+      auto it = devices.find(p[2]);
+      if (it == devices.end()) {
+        return Error(404, "not_found");
+      }
+      it->second.revoked = true;
+      std::erase_if(mail, [&](const Mail& x) { return x.to == p[2]; });
+      HttpResponse r;
+      r.status = 204;
+      return r;
+    }
+  }
+  if (m == "POST" && p.size() == 2 && p[1] == "invites") {
+    base::DictValue d;
+    d.Set("token", AddToken());
+    d.Set("expires", 1);
+    return Json(201, d);
+  }
+  if (p.size() >= 2 && p[1] == "messages") {
+    if (m == "POST") {
+      const std::string to = *body->FindString("to_device");
+      if (!devices.count(to)) {
+        return Error(404, "not_found");
+      }
+      const int64_t id = next_++;
+      mail.push_back(Mail{id, to, self, *body->FindString("kind"),
+                          *body->FindString("data")});
+      base::DictValue d;
+      d.Set("id", static_cast<int>(id));
+      return Json(201, d);
+    }
+    if (m == "GET") {
+      base::ListValue list;
+      for (const Mail& x : mail) {
+        if (x.to == self) {
+          base::DictValue d;
+          d.Set("id", static_cast<int>(x.id));
+          d.Set("from_device", x.from);
+          d.Set("kind", x.kind);
+          d.Set("data", x.data);
+          list.Append(std::move(d));
+        }
+      }
+      base::DictValue d;
+      d.Set("messages", std::move(list));
+      return Json(200, d);
+    }
+    if (m == "DELETE" && p.size() == 3) {
+      int64_t id = 0;
+      base::StringToInt64(p[2], &id);
+      std::erase_if(mail, [&](const Mail& x) {
+        return x.id == id && x.to == self;
+      });
+      HttpResponse r;
+      r.status = 204;
+      return r;
+    }
+  }
+  if (p.size() >= 2 && p[1] == "vaults") {
+    if (p.size() == 2 && m == "GET") {
+      base::ListValue list;
+      for (const auto& [uuid, objects] : vaults) {
+        base::DictValue d;
+        d.Set("vault_uuid", uuid);
+        d.Set("display_name", "Corvid");
+        list.Append(std::move(d));
+      }
+      base::DictValue d;
+      d.Set("vaults", std::move(list));
+      return Json(200, d);
+    }
+    if (p.size() == 3 && m == "PUT") {
+      vaults[p[2]];
+      HttpResponse r;
+      r.status = 201;
+      r.body = "{}";
+      return r;
+    }
+    auto vault = p.size() >= 3 ? vaults.find(p[2]) : vaults.end();
+    if (vault == vaults.end()) {
+      return Error(404, "not_found");
+    }
+    if (p.size() == 3 && m == "DELETE") {
+      vaults.erase(vault);
+      HttpResponse r;
+      r.status = 204;
+      return r;
+    }
+    if (p.size() == 4 && p[3] == "collect" && m == "POST") {
+      base::DictValue d;
+      d.Set("deleted", 0);
+      return Json(200, d);
+    }
+    if (p.size() == 5 && p[3] == "objects") {
+      const std::string& id = p[4];
+      auto object = vault->second.find(id);
+      if (m == "GET") {
+        if (object == vault->second.end()) {
+          return Error(404, "no_object");
+        }
+        HttpResponse r;
+        r.status = 200;
+        r.body = object->second.data;
+        r.etag = object->second.revision;
+        return r;
+      }
+      if (m == "PUT") {
+        const bool mutable_object = id == "head" || id == "roster";
+        if (!mutable_object) {
+          if (base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(
+                  request.body))) != id ||
+              Header(request, "X-Retention-Epoch").empty()) {
+            return Error(400, "bad_object");
+          }
+        }
+        const std::string if_match = Header(request, "If-Match");
+        if (Header(request, "If-None-Match") == "*") {
+          if (object != vault->second.end()) {
+            return Error(412, "conflict");
+          }
+        } else if (if_match.empty() || object == vault->second.end() ||
+                   if_match != "\"" + object->second.revision + "\"") {
+          return Error(412, "conflict");
+        }
+        std::string revision = NextRevision();
+        vault->second[id] = Object{request.body, revision};
+        HttpResponse r;
+        r.status = 201;
+        r.etag = revision;
+        return r;
+      }
+    }
+  }
+  return Error(400, "bad_request");
+}
+
