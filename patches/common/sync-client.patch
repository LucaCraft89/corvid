+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#ifndef COMPONENTS_CORVID_SYNC_API_CLIENT_H_
+#define COMPONENTS_CORVID_SYNC_API_CLIENT_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+#include "components/corvid_sync/http.h"
+#include "components/corvid_sync/keys.h"
+
+// Client for the sync server's HTTP API (sync/protocol/SPEC.md, section 3).
+// Blocking; use it on the sync thread or the account task runner only.
+namespace corvid_sync {
+
+struct ApiError {
+  enum class Kind {
+    kNetwork,       // No HTTP answer.
+    kAborted,       // Cancelled by the browser.
+    kUnauthorized,  // 401 unauthorized
+    kRevoked,       // 401 device_revoked
+    kTokenInvalid,  // 403 token_invalid
+    kNotFound,      // 404 not_found
+    kNoObject,      // 404 no_object
+    kConflict,      // 412
+    kTooLarge,      // 413
+    kQuota,         // 507
+    kServer,        // Other 4xx/5xx.
+    kBadResponse,   // 2xx we could not read.
+  };
+  Kind kind = Kind::kServer;
+  int status = 0;
+  std::string code;
+  std::string message;
+};
+
+// Human-readable, for the sync page.
+std::string ApiErrorText(const ApiError& error);
+
+struct Registration {
+  std::string account;
+  std::string device_id;
+  std::string device_secret;
+};
+
+struct DeviceInfo {
+  std::string id;
+  std::string name;
+  Key public_key{};
+  int64_t created = 0;
+  int64_t last_seen = 0;
+  bool revoked = false;
+};
+
+struct VaultInfo {
+  std::string uuid;
+  std::string display_name;
+};
+
+struct Message {
+  int64_t id = 0;
+  std::string from_device;
+  std::string kind;
+  std::vector<uint8_t> data;
+};
+
+struct StoredObject {
+  std::vector<uint8_t> data;
+  std::string revision;
+};
+
+// "https://host[:port][/prefix]" with no trailing slash, or "" when the URL
+// is not allowed: https anywhere, plain http only to this computer
+// (localhost, 127.0.0.0/8, [::1]).
+std::string NormalizeServerUrl(std::string_view url);
+
+class ApiClient {
+ public:
+  template <typename T>
+  using Result = base::expected<T, ApiError>;
+  using Status = base::expected<void, ApiError>;
+
+  // `http` must outlive this client. `server_url` is normalized.
+  ApiClient(BlockingHttp* http, std::string server_url, std::string secret);
+  ~ApiClient();
+
+  void set_secret(std::string secret) { secret_ = std::move(secret); }
+  const std::string& server_url() const { return server_url_; }
+
+  Status Health();
+  Result<Registration> Register(std::string_view token,
+                                std::string_view name,
+                                const Key& public_key);
+  Result<std::vector<DeviceInfo>> Devices();
+  Status RevokeDevice(std::string_view id);
+  // One-time registration token for the same account.
+  Result<std::string> CreateInvite(int64_t ttl_seconds);
+
+  Result<std::vector<VaultInfo>> Vaults();
+  Status PutVault(std::string_view uuid, std::string_view display_name);
+  Status DeleteVault(std::string_view uuid);
+
+  // nullopt when the object is absent (404 no_object).
+  Result<std::optional<StoredObject>> ReadObject(std::string_view uuid,
+                                                 std::string_view id,
+                                                 size_t max_bytes);
+  // No `expected_revision`: create only. Returns the new revision.
+  Result<std::string> WriteObject(std::string_view uuid,
+                                  std::string_view id,
+                                  const std::optional<std::string>& expected,
+                                  const std::vector<uint8_t>& data,
+                                  std::optional<uint32_t> retention_epoch);
+  Status Collect(std::string_view uuid, uint32_t minimum_retained_epoch);
+
+  Status PostMessage(std::string_view to,
+                     std::string_view kind,
+                     base::span<const uint8_t> data);
+  Result<std::vector<Message>> Messages();
+  Status DeleteMessage(int64_t id);
+
+ private:
+  Result<HttpResponse> Do(std::string method,
+                          std::string path,
+                          std::string body = std::string(),
+                          std::string content_type = std::string(),
+                          std::vector<std::pair<std::string, std::string>>
+                              headers = {});
+  Result<HttpResponse> DoJson(std::string method,
+                              std::string path,
+                              const base::DictValue* body);
+
+  const raw_ptr<BlockingHttp> http_;
+  const std::string server_url_;
+  std::string secret_;
+};
+
+}  // namespace corvid_sync
+
+#endif  // COMPONENTS_CORVID_SYNC_API_CLIENT_H_
