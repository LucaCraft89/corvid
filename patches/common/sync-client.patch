+  ASSERT_TRUE(a.CreateVault(kTestServerUrl, server_.AddToken(), "a").has_value());
+  auto code = a.CreateInvite();
+  ASSERT_TRUE(code.has_value());
+  const std::string token = code->substr(0, code->find('~'));
+  const std::string forged = token + "~" + std::string(43, 'A') + "~" +
+                             a.state().device_id;
