+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#ifndef COMPONENTS_CORVID_SYNC_ACCOUNT_H_
+#define COMPONENTS_CORVID_SYNC_ACCOUNT_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/types/expected.h"
+#include "components/corvid_sync/api_client.h"
+#include "components/corvid_sync/keys.h"
+#include "components/corvid_sync/roster.h"
+#include "components/sync/engine/sync_vault/sync_vault_format.h"
+
+namespace corvid_sync {
+
+// Everything this device must remember. Saved encrypted in the profile
+// (service.h). The checkpoint is saved apart: the sync thread updates it.
+struct DeviceState {
+  std::string server_url;
+  std::string account;
+  std::string device_id;
+  std::string device_name;
+  std::string device_secret;
+  Key identity{};  // X25519 private key.
+
+  // No vault_uuid: this device has no vault key yet.
+  std::string vault_uuid;
+  std::string vault_name;
+  Key vault_key{};
+  uint64_t roster_version = 0;
+  // Last authenticated roster: decides whose rotation is trusted, also after
+  // the old vault is gone.
+  std::optional<Roster> roster;
+
+  // New-device side of a pairing, until the vault key arrives.
+  std::optional<Key> join_secret;
+  std::string join_approver;
+
+  // The server said this device was removed.
+  bool revoked = false;
+
+  bool registered() const { return !device_id.empty(); }
+  bool has_vault() const { return !vault_uuid.empty(); }
+
+  std::string ToJson() const;
+  static std::optional<DeviceState> FromJson(std::string_view json);
+
+  bool operator==(const DeviceState&) const = default;
+};
+
+// A device that used one of our invites and waits for approval.
+struct Pairing {
+  std::string device_id;
+  std::string name;
+  std::string code;  // Must match the code on the new device.
+  Key public_key{};
+  Key secret{};
+};
+
+// A row of the page's device list.
+struct DeviceRow {
+  std::string id;
+  std::string name;
+  int64_t last_seen = 0;
+  bool is_this_device = false;
+  // Listed in the authenticated roster (holds the vault key).
+  bool in_roster = false;
+};
+
+// What went wrong; `integrity` marks tampering or wrong keys, as opposed to
+// the network or the user's input.
+struct AccountError {
+  std::string text;
+  bool integrity = false;
+  bool revoked = false;
+};
+
+// The device operations of SPEC.md section 4. Blocking: lives on one worker
+// sequence. Failed operations leave the state as it was, except that a
+// registered device stays registered.
+class Account {
+ public:
+  template <typename T>
+  using Result = base::expected<T, AccountError>;
+  using Status = base::expected<void, AccountError>;
+
+  // `http` must outlive this object.
+  Account(BlockingHttp* http, DeviceState state);
+  Account(const Account&) = delete;
+  Account& operator=(const Account&) = delete;
+  ~Account();
+
+  const DeviceState& state() const { return state_; }
+  // Checkpoint to use for the current vault. The caller keeps it current.
+  void set_checkpoint(std::optional<syncer::SyncVaultCheckpoint> checkpoint) {
+    checkpoint_ = std::move(checkpoint);
+  }
+  const std::optional<syncer::SyncVaultCheckpoint>& checkpoint() const {
+    return checkpoint_;
+  }
+
+  // First device: registers with an admin token and makes a new vault.
+  // Returns the recovery key.
+  Result<std::string> CreateVault(std::string_view server_url,
+                                  std::string_view token,
+                                  std::string_view device_name);
+
+  // New device: registers with an invite code and asks for the vault key.
+  Status Join(std::string_view server_url,
+              std::string_view invite_code,
+              std::string_view device_name);
+  // Shown on the new device while it waits.
+  Result<std::string> JoinComparisonCode();
+
+  // Registers with an admin token, finds the vault the recovery key opens and
+  // joins it.
+  Status Recover(std::string_view server_url,
+                 std::string_view token,
+                 std::string_view device_name,
+                 std::string_view recovery_key);
+
+  // Approver side.
+  Result<std::string> CreateInvite();
+  const std::map<std::string, Pairing>& pairings() const { return pairings_; }
+  // Only after the user confirmed both devices show the same code.
+  Status Approve(std::string_view device_id);
+  void Reject(std::string_view device_id);
+
+  // Handles the mailbox: pair requests, vault keys, rotations. Returns true
+  // when this device moved to another vault (restart the sync engine).
+  Result<bool> ProcessMessages();
+
+  // Refreshes `state().roster`.
+  Status RefreshRoster();
+  Result<std::vector<DeviceRow>> ListDevices();
+
+  // Revokes the device, then moves everyone else to a new vault and key.
+  // Returns the new recovery key. The caller restarts the sync engine.
+  Result<std::string> RemoveDevice(std::string_view device_id);
+
+  // Turns sync off here: leaves the roster and the account; forgets the state.
+  // Local browser data stays. Best effort on the server.
+  void Leave();
+
+  std::string RecoveryKey() const;
+
+ private:
+  void Adopt(const VaultGrant& grant);
+  Result<Roster> ReadRoster(std::string_view uuid,
+                            const Key& key,
+                            uint64_t min_version,
+                            std::optional<std::string>* revision);
+  template <typename Fn>
+  Status UpdateRoster(std::string_view uuid, const Key& key, Fn fn);
+  Status InitializeVault(std::string_view uuid, const Key& key);
+  Status HandleMessage(const Message& message, bool* vault_changed);
+  Result<Key> ServerPublicKey(std::string_view device_id, std::string* name);
+  Status Register(std::string_view server_url,
+                  std::string_view token,
+                  std::string_view device_name);
+
+  const raw_ptr<BlockingHttp> http_;
+  DeviceState state_;
+  std::optional<syncer::SyncVaultCheckpoint> checkpoint_;
+  // In memory only: invites and pending pairings die with the browser
+  // process, which only means making a new invite.
+  std::map<std::string, Key> invites_;  // Server token -> pairing secret.
+  std::map<std::string, Pairing> pairings_;
+};
+
+}  // namespace corvid_sync
+
+#endif  // COMPONENTS_CORVID_SYNC_ACCOUNT_H_
