+
+#include "components/corvid_sync/keys.h"
+
+#include <string>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+// Vectors from sync/protocol/vectors-pairing.json and vectors-vault.json, made
+// by the Go reference client.
+namespace corvid_sync {
+namespace {
+
+std::vector<uint8_t> Hex(const std::string& s) {
+  std::vector<uint8_t> out;
+  EXPECT_TRUE(base::HexStringToBytes(s, &out));
+  return out;
+}
+
+Key K(const std::string& s) {
+  std::vector<uint8_t> v = Hex(s);
+  Key k{};
+  std::copy(v.begin(), v.end(), k.begin());
+  return k;
+}
+
+std::string HexOf(base::span<const uint8_t> b) {
+  return base::ToLowerASCII(base::HexEncode(b));
+}
+
+const char kVaultKey[] = "1111111111111111111111111111111111111111111111111111111111111111";
+const char kRecovery[] = "CVK1-CEIRC-EIRCE-IRCEI-RCEIR-CEIRC-EIRCE-IRCEI-RCEIR-CEIRC-EIRCE-IQFVA";
+const char kPairSecret[] = "2222222222222222222222222222222222222222222222222222222222222222";
+const char kApproverPriv[] = "3333333333333333333333333333333333333333333333333333333333333333";
+const char kApproverPub[] = "7b0d47d93427f8311160781c7c733fd89f88970aef490d8aa0ee19a4cb8a1b14";
+const char kNewPriv[] = "4444444444444444444444444444444444444444444444444444444444444444";
+const char kNewPub[] = "ff2ee45601ec1b67310c7790404585ae697331eee1c1f8cf2419731c1fff3e6b";
+const char kProof[] = "0cdd28fadf0293c63a74e1558195fcfc13640fc3a20d0395dffff13d0fc92932";
+const char kCode[] = "962747";
+const char kUuid[] = "6b1f0c2e-7d3a-4e5b-8c9d-0a1b2c3d4e5f";
+const char kName[] = "Alice";
+const char kOldUuid[] = "0f8e7a3c-2b1d-4c5e-9f60-718293a4b5c6";
+const char kRotationSalt[] = "cee577c23ec2f160b1456a162534fee437c789670ef92bfa458ffd8d0f114751";
+const char kNonce[] = "555555555555555555555555";
+const char kKeyEnvelope[] = "";
+const char kRotateEnvelope[] = "";
+const char kObjVaultKey[] = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
+const char kObjUuid[] = "0f8e7a3c-2b1d-4c5e-9f60-718293a4b5c6";
+const char kRosterPlain[] = "7b2276657273696f6e223a312c2264657669636573223a5b5d7d";
+const char kRosterNonce[] = "060606060606060606060606";
+const char kRosterContainer[] = "0606060606060606060606062ac6ec30d9886722360fddb72f1148924e0b52d8dbcda1dbd6519432dbc8cd13115f78c890d31b6711e3";
+
+std::array<uint8_t, 12> Nonce(const std::string& hex) {
+  std::vector<uint8_t> v = Hex(hex);
+  std::array<uint8_t, 12> n{};
+  std::copy(v.begin(), v.end(), n.begin());
+  return n;
+}
+
+TEST(CorvidSyncKeys, PublicKeys) {
+  EXPECT_EQ(PublicKeyFor(K(kApproverPriv)), K(kApproverPub));
+  EXPECT_EQ(PublicKeyFor(K(kNewPriv)), K(kNewPub));
+}
+
+TEST(CorvidSyncKeys, PairProofAndCode) {
+  EXPECT_EQ(PairProof(K(kPairSecret), K(kNewPub)), K(kProof));
+  EXPECT_EQ(ComparisonCode(K(kPairSecret), K(kApproverPub), K(kNewPub)), kCode);
+  // Swapped keys (what a lying server would cause) give another code.
+  EXPECT_NE(ComparisonCode(K(kPairSecret), K(kNewPub), K(kApproverPub)), kCode);
+}
+
+TEST(CorvidSyncKeys, RotationSalt) {
+  // The vector's old vault key is 32 bytes of 0x66.
+  Key old_key;
+  old_key.fill(0x66);
+  EXPECT_EQ(RotationSalt(old_key, kOldUuid), K(kRotationSalt));
+}
+
+TEST(CorvidSyncKeys, RecoveryKey) {
+  EXPECT_EQ(EncodeRecoveryKey(K(kVaultKey)), kRecovery);
+  EXPECT_EQ(DecodeRecoveryKey(kRecovery), K(kVaultKey));
+  // Tolerated: case, spaces, no dashes.
+  std::string loose = base::ToLowerASCII(std::string(kRecovery));
+  EXPECT_EQ(DecodeRecoveryKey(loose), K(kVaultKey));
+  std::string no_dash(kRecovery);
+  std::erase(no_dash, '-');
+  EXPECT_EQ(DecodeRecoveryKey(no_dash), K(kVaultKey));
+  // Typos.
+  std::string typo(kRecovery);
+  typo[7] = typo[7] == 'A' ? 'B' : 'A';
+  EXPECT_FALSE(DecodeRecoveryKey(typo));
+  EXPECT_FALSE(DecodeRecoveryKey(""));
+  EXPECT_FALSE(DecodeRecoveryKey("CVK1-AAAAA"));
+  EXPECT_FALSE(DecodeRecoveryKey("not a key!"));
+}
+
+TEST(CorvidSyncKeys, OpensGoEnvelopes) {
+  auto grant = OpenEnvelope(K(kNewPriv), K(kApproverPub), K(kPairSecret),
+                            kKindVaultKey, Hex(kKeyEnvelope));
+  ASSERT_TRUE(grant);
+  EXPECT_EQ(grant->vault_uuid, kUuid);
+  EXPECT_EQ(grant->vault_key, K(kVaultKey));
+  EXPECT_EQ(grant->display_name, kName);
+  EXPECT_TRUE(grant->replaces_uuid.empty());
+
+  auto rotated = OpenEnvelope(K(kNewPriv), K(kApproverPub), K(kRotationSalt),
+                              kKindVaultRotate, Hex(kRotateEnvelope));
+  ASSERT_TRUE(rotated);
+  EXPECT_EQ(rotated->replaces_uuid, kOldUuid);
+}
+
+TEST(CorvidSyncKeys, EnvelopeRejects) {
+  std::vector<uint8_t> env = Hex(kKeyEnvelope);
+  const Key priv = K(kNewPriv), pub = K(kApproverPub), secret = K(kPairSecret);
+  EXPECT_TRUE(OpenEnvelope(priv, pub, secret, kKindVaultKey, env));
+  // Wrong pairing secret, kind, sender, recipient.
+  EXPECT_FALSE(OpenEnvelope(priv, pub, K(kVaultKey), kKindVaultKey, env));
+  EXPECT_FALSE(OpenEnvelope(priv, pub, secret, kKindVaultRotate, env));
+  EXPECT_FALSE(OpenEnvelope(priv, K(kNewPub), secret, kKindVaultKey, env));
+  EXPECT_FALSE(OpenEnvelope(K(kApproverPriv), pub, secret, kKindVaultKey, env));
+  // Tampered, truncated.
+  std::vector<uint8_t> bad = env;
+  bad[20] ^= 1;
+  EXPECT_FALSE(OpenEnvelope(priv, pub, secret, kKindVaultKey, bad));
+  EXPECT_FALSE(OpenEnvelope(priv, pub, secret, kKindVaultKey,
+                            base::span(env).first(10u)));
+}
+
+TEST(CorvidSyncKeys, SealThenOpen) {
+  VaultGrant grant{kUuid, K(kVaultKey), kName, kOldUuid};
+  auto env = SealEnvelope(K(kApproverPriv), K(kNewPub), K(kPairSecret),
+                          kKindVaultRotate, grant, Nonce(kNonce));
+  EXPECT_EQ(HexOf(base::span(env).first(12u)), kNonce);
+  auto opened = OpenEnvelope(K(kNewPriv), K(kApproverPub), K(kPairSecret),
+                             kKindVaultRotate, env);
+  ASSERT_TRUE(opened);
+  EXPECT_EQ(*opened, grant);
+}
+
+TEST(CorvidSyncKeys, RosterContainerMatchesGo) {
+  ObjectCrypto crypto(K(kObjVaultKey), kObjUuid);
+  EXPECT_EQ(HexOf(crypto.Encrypt(ObjectCrypto::kRoleRoster, Hex(kRosterPlain),
+                                 Nonce(kRosterNonce))),
+            kRosterContainer);
+  auto plain = crypto.Decrypt(ObjectCrypto::kRoleRoster, Hex(kRosterContainer));
+  ASSERT_TRUE(plain);
+  EXPECT_EQ(HexOf(*plain), kRosterPlain);
+  // Another role or vault does not open it.
+  EXPECT_FALSE(crypto.Decrypt(1, Hex(kRosterContainer)));
+  ObjectCrypto other(K(kObjVaultKey), kUuid);
+  EXPECT_FALSE(other.Decrypt(ObjectCrypto::kRoleRoster, Hex(kRosterContainer)));
+}
+
+TEST(CorvidSyncKeys, Uuid) {
+  EXPECT_TRUE(IsValidUuid(NewVaultUuid()));
+  EXPECT_FALSE(IsValidUuid("nope"));
+}
+
