+  // Registered on the account (the server could do this) but not in the
+  // roster: it cannot move anyone to its own vault.
+  Account evil(&server_, DeviceState());
+  ASSERT_TRUE(evil.CreateVault(kTestServerUrl, server_.AddToken(), "e")
+                  .has_value());
+  const std::string before = Vault(b);
+  std::vector<uint8_t> envelope = SealEnvelope(
+      evil.state().identity, PublicKeyFor(b.state().identity),
+      RotationSalt(b.state().vault_key, before), kKindVaultRotate,
+      VaultGrant{Vault(evil), evil.state().vault_key, "x", before});
+  ApiClient api(&server_, kTestServerUrl, evil.state().device_secret);
+  ASSERT_TRUE(
+      api.PostMessage(b.state().device_id, kKindVaultRotate, envelope)
+          .has_value());
+  auto processed = b.ProcessMessages();
+  ASSERT_FALSE(processed.has_value());
+  EXPECT_TRUE(processed.error().integrity);
+  EXPECT_EQ(Vault(b), before);
+}
+
+TEST_F(CorvidSyncAccountTest, OfflineLeavesStateAlone) {
+  Account a(&server_, DeviceState());
+  ASSERT_TRUE(a.CreateVault(kTestServerUrl, server_.AddToken(), "a").has_value());
+  const DeviceState before = a.state();
+  server_.offline = true;
+  auto processed = a.ProcessMessages();
+  ASSERT_FALSE(processed.has_value());
+  EXPECT_FALSE(processed.error().integrity);
+  EXPECT_FALSE(a.CreateInvite().has_value());
+  EXPECT_EQ(a.state(), before);
+}
+
+TEST_F(CorvidSyncAccountTest, Leave) {
+  Account a(&server_, DeviceState());
+  ASSERT_TRUE(a.CreateVault(kTestServerUrl, server_.AddToken(), "a").has_value());
+  Account b(&server_, DeviceState());
+  ASSERT_NO_FATAL_FAILURE(Pair(a, b, "b"));
+  const std::string id = b.state().device_id;
+  b.Leave();
+  EXPECT_FALSE(b.state().registered());
+  EXPECT_TRUE(server_.devices[id].revoked);
+  ASSERT_TRUE(a.RefreshRoster().has_value());
+  EXPECT_FALSE(a.state().roster->IsActive(id));
+}
+
