+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_ui.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace corvid {
+
+namespace {
+
+constexpr const char* kMessages[] = {
+    "corvidSyncGet",     "corvidSyncCreate",  "corvidSyncJoin",
+    "corvidSyncRecover", "corvidSyncInvite",  "corvidSyncApprove",
+    "corvidSyncReject",  "corvidSyncRemove",  "corvidSyncShowKey",
+    "corvidSyncOff",
+};
+
+}  // namespace
+
+// static
+CorvidSyncServiceFactory* CorvidSyncServiceFactory::GetInstance() {
+  static base::NoDestructor<CorvidSyncServiceFactory> instance;
+  return instance.get();
+}
+
+// static
+corvid_sync::Service* CorvidSyncServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<corvid_sync::Service*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+CorvidSyncServiceFactory::CorvidSyncServiceFactory()
+    : ProfileKeyedServiceFactory("CorvidSyncService",
+                                 ProfileSelections::BuildForRegularProfile()) {
+  DependsOn(SyncServiceFactory::GetInstance());
+}
+
+CorvidSyncServiceFactory::~CorvidSyncServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+CorvidSyncServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  return std::make_unique<corvid_sync::Service>(
+      profile->GetPrefs(),
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess(),
+      g_browser_process->os_crypt_async(),
+      SyncServiceFactory::GetForProfile(profile));
+}
+
+bool CorvidSyncServiceFactory::ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+SyncPageHandler::SyncPageHandler(Profile* profile)
+    : service_(CorvidSyncServiceFactory::GetForProfile(profile)) {}
+
+SyncPageHandler::~SyncPageHandler() = default;
+
+void SyncPageHandler::RegisterMessages() {
+  for (const char* message : kMessages) {
+    web_ui()->RegisterMessageCallback(
+        message,
+        base::BindRepeating(&SyncPageHandler::HandleMessage,
+                            base::Unretained(this), std::string(message)));
+  }
+}
+
+void SyncPageHandler::OnJavascriptAllowed() {
+  if (service_) {
+    observation_.Observe(service_);
+  }
+}
+
+void SyncPageHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+}
+
+void SyncPageHandler::OnSyncViewChanged(const base::DictValue& view,
+                                        const base::DictValue& transient) {
+  base::DictValue event = transient.Clone();
+  event.Set("view", view.Clone());
+  CallJavascriptFunction("corvidBrowser.dispatch", base::Value("sync"), event);
+}
+
+void SyncPageHandler::HandleMessage(const std::string& message,
+                                    const base::ListValue& args) {
+  AllowJavascript();
+  if (!service_) {
+    // Private and guest windows have no sync.
+    base::DictValue view;
+    view.Set("mode", "unavailable");
+    OnSyncViewChanged(view, base::DictValue());
+    return;
+  }
+  auto arg = [&args](size_t i) {
+    return i < args.size() && args[i].is_string() ? args[i].GetString()
+                                                  : std::string();
+  };
+  if (message == "corvidSyncGet") {
+    OnSyncViewChanged(service_->View(), base::DictValue());
+    service_->Refresh();
+  } else if (message == "corvidSyncCreate") {
+    service_->CreateVault(arg(0), arg(1), arg(2));
+  } else if (message == "corvidSyncJoin") {
+    service_->Join(arg(0), arg(1), arg(2));
+  } else if (message == "corvidSyncRecover") {
+    service_->Recover(arg(0), arg(1), arg(2), arg(3));
+  } else if (message == "corvidSyncInvite") {
+    service_->CreateInvite();
+  } else if (message == "corvidSyncApprove") {
+    service_->Approve(arg(0));
+  } else if (message == "corvidSyncReject") {
+    service_->Reject(arg(0));
+  } else if (message == "corvidSyncRemove") {
+    service_->RemoveDevice(arg(0));
+  } else if (message == "corvidSyncShowKey") {
+    service_->ShowRecoveryKey();
+  } else if (message == "corvidSyncOff") {
+    service_->TurnOff();
+  }
+}
+
+}  // namespace corvid
