+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#include "components/corvid_sync/roster.h"
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace corvid_sync {
+
+RosterEntry* Roster::Find(std::string_view device_id) {
+  for (RosterEntry& e : devices) {
+    if (e.device_id == device_id) {
+      return &e;
+    }
+  }
+  return nullptr;
+}
+
+const RosterEntry* Roster::Find(std::string_view device_id) const {
+  return const_cast<Roster*>(this)->Find(device_id);
+}
+
+bool Roster::IsActive(std::string_view device_id) const {
+  const RosterEntry* e = Find(device_id);
+  return e && !e->revoked;
+}
+
+std::string Roster::ToJson() const {
+  // Built by hand so the version stays an exact integer (base::Value has no
+  // 64-bit integers) and the key order matches Go's.
+  std::string out = "{\"version\":" + base::NumberToString(version) +
+                    ",\"devices\":[";
+  for (size_t i = 0; i < devices.size(); ++i) {
+    const RosterEntry& e = devices[i];
+    base::DictValue d;
+    d.Set("device_id", e.device_id);
+    d.Set("name", e.name);
+    d.Set("public_key", Base64(e.public_key));
+    d.Set("added_by", e.added_by);
+    if (e.revoked) {
+      d.Set("revoked", true);
+    }
+    if (i) {
+      out += ",";
+    }
+    out += base::WriteJson(d).value_or("{}");
+  }
+  return out + "]}";
+}
+
+std::optional<Roster> Roster::FromJson(std::string_view json) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& d = value->GetDict();
+  Roster roster;
+  const base::Value* version = d.Find("version");
+  if (!version) {
+    return std::nullopt;
+  }
+  if (version->is_int() && version->GetInt() >= 0) {
+    roster.version = static_cast<uint64_t>(version->GetInt());
+  } else if (version->is_double() && version->GetDouble() >= 0) {
+    roster.version = static_cast<uint64_t>(version->GetDouble());
+  } else {
+    return std::nullopt;
+  }
+  const base::Value* devices_value = d.Find("devices");
+  if (!devices_value) {
+    return std::nullopt;
+  }
+  // Go writes a nil slice as null.
+  if (devices_value->is_none()) {
+    return roster;
+  }
+  if (!devices_value->is_list()) {
+    return std::nullopt;
+  }
+  for (const base::Value& v : devices_value->GetList()) {
+    if (!v.is_dict()) {
+      return std::nullopt;
+    }
+    const base::DictValue& e = v.GetDict();
+    const std::string* id = e.FindString("device_id");
+    const std::string* pub = e.FindString("public_key");
+    if (!id || !pub) {
+      return std::nullopt;
+    }
+    std::optional<Key> key = KeyFromBase64(*pub);
+    if (!key) {
+      return std::nullopt;
+    }
+    const std::string* name = e.FindString("name");
+    const std::string* added_by = e.FindString("added_by");
+    roster.devices.push_back(RosterEntry{
+        *id, name ? *name : std::string(), *key,
+        added_by ? *added_by : std::string(),
+        e.FindBool("revoked").value_or(false)});
+  }
+  return roster;
+}
+
+}  // namespace corvid_sync
