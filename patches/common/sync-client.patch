+  ASSERT_TRUE(key.has_value());
+  EXPECT_EQ(DecodeRecoveryKey(*key), a.state().vault_key);
+  EXPECT_EQ(a.RecoveryKey(), *key);
+  ASSERT_TRUE(a.state().roster);
+  EXPECT_EQ(a.state().roster->version, 1u);
+  EXPECT_TRUE(a.state().roster->IsActive(a.state().device_id));
+  // The vault reads back through Helium's store as initialized and empty.
+  auto read = MakeStore(a)->ReadState();
+  ASSERT_TRUE(read.has_value());
+  EXPECT_EQ(read->generation(), 0u);
