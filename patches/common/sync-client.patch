+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#include "components/corvid_sync/keys.h"
+
+#include <utility>
+
+#include "base/base64.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "crypto/aead.h"
+#include "crypto/hash.h"
+#include "crypto/hmac.h"
+#include "crypto/kdf.h"
+#include "crypto/random.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+
+namespace corvid_sync {
+
+namespace {
+
+constexpr char kLabelPairProof[] = "corvid-sync-v1/pair-request";
+constexpr char kLabelComparison[] = "corvid-sync-v1/comparison-code";
+constexpr char kLabelEnvelope[] = "corvid-sync-v1/envelope";
+constexpr char kLabelRotate[] = "corvid-sync-v1/rotate";
+constexpr char kRecoveryTag[] = "CVK1";
+// Helium's wire labels, kept for compatibility (SPEC.md section 2).
+constexpr char kObjectKeyInfo[] =
+    "helium-private-sync-v1/object-aead/aes-256-gcm-siv";
+constexpr char kObjectAdPrefix[] = "helium-private-sync-v1/object/";
+constexpr size_t kNonceSize = 12;
+constexpr char kBase32Alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
+
+void Append(std::vector<uint8_t>& out, std::string_view s) {
+  out.insert(out.end(), s.begin(), s.end());
+}
+
+void Append(std::vector<uint8_t>& out, base::span<const uint8_t> s) {
+  out.insert(out.end(), s.begin(), s.end());
+}
+
+Key Hmac(base::span<const uint8_t> key, base::span<const uint8_t> data) {
+  return crypto::hmac::SignSha256(key, data);
+}
+
+std::string Base32NoPad(base::span<const uint8_t> in) {
+  std::string out;
+  uint32_t buffer = 0;
+  int bits = 0;
+  for (uint8_t b : in) {
+    buffer = (buffer << 8) | b;
+    bits += 8;
+    while (bits >= 5) {
+      out.push_back(kBase32Alphabet[(buffer >> (bits - 5)) & 31]);
+      bits -= 5;
+    }
+  }
+  if (bits > 0) {
+    out.push_back(kBase32Alphabet[(buffer << (5 - bits)) & 31]);
+  }
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> FromBase32NoPad(std::string_view in) {
+  std::vector<uint8_t> out;
+  uint32_t buffer = 0;
+  int bits = 0;
+  for (char c : in) {
+    const char* p = strchr(kBase32Alphabet, c);
+    if (!c || !p) {
+      return std::nullopt;
+    }
+    buffer = (buffer << 5) | static_cast<uint32_t>(p - kBase32Alphabet);
+    bits += 5;
+    if (bits >= 8) {
+      out.push_back(static_cast<uint8_t>(buffer >> (bits - 8)));
+      bits -= 8;
+    }
+  }
+  // Leftover bits must be zero padding (canonical encoding, like Go's).
+  if (bits >= 5 || (buffer & ((1u << bits) - 1)) != 0) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+Key EnvelopeKey(const Key& self_private,
+                const Key& peer_public,
+                base::span<const uint8_t> salt,
+                std::string_view kind,
+                const Key& sender_public,
+                const Key& recipient_public,
+                bool* ok) {
+  Key shared{};
+  *ok = X25519(shared.data(), self_private.data(), peer_public.data()) == 1;
+  std::vector<uint8_t> info;
+  Append(info, std::string(kLabelEnvelope) + "/" + std::string(kind) + "/");
+  Append(info, sender_public);
+  Append(info, recipient_public);
+  return crypto::kdf::Hkdf<kKeySize>(crypto::hash::kSha256, shared, salt,
+                                     info);
+}
+
+std::string EnvelopeAd(std::string_view kind) {
+  return std::string(kLabelEnvelope) + "/" + std::string(kind);
+}
+
+}  // namespace
+
+Key NewPrivateKey() {
+  Key pub, priv;
+  X25519_keypair(pub.data(), priv.data());
+  return priv;
+}
+
+Key PublicKeyFor(const Key& private_key) {
+  Key pub;
+  X25519_public_from_private(pub.data(), private_key.data());
+  return pub;
+}
+
+Key RandomKey() {
+  return crypto::RandBytesAsArray<kKeySize>();
+}
+
+std::string NewVaultUuid() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+bool IsValidUuid(std::string_view uuid) {
+  base::Uuid parsed = base::Uuid::ParseLowercase(uuid);
+  return parsed.is_valid();
+}
+
+Key PairProof(base::span<const uint8_t> pair_secret,
+              base::span<const uint8_t> new_public) {
+  std::vector<uint8_t> data;
+  Append(data, kLabelPairProof);
+  Append(data, new_public);
+  return Hmac(pair_secret, data);
+}
+
+std::string ComparisonCode(base::span<const uint8_t> pair_secret,
+                           base::span<const uint8_t> approver_public,
+                           base::span<const uint8_t> new_public) {
+  std::vector<uint8_t> data;
+  Append(data, kLabelComparison);
+  Append(data, approver_public);
+  Append(data, new_public);
+  Key sum = Hmac(pair_secret, data);
+  uint64_t value =
+      base::U64FromBigEndian(base::span(sum).first<8>());
+  return base::StringPrintf("%06llu",
+                            static_cast<unsigned long long>(value % 1000000));
+}
+
+Key RotationSalt(base::span<const uint8_t> old_vault_key,
+                 std::string_view old_vault_uuid) {
+  std::vector<uint8_t> data;
+  Append(data, kLabelRotate);
+  Append(data, old_vault_uuid);
+  return Hmac(old_vault_key, data);
+}
+
+std::vector<uint8_t> SealEnvelope(const Key& sender_private,
+                                  const Key& recipient_public,
+                                  base::span<const uint8_t> salt,
+                                  std::string_view kind,
+                                  const VaultGrant& grant,
+                                  std::optional<std::array<uint8_t, 12>> nonce) {
+  const Key sender_public = PublicKeyFor(sender_private);
+  bool ok = false;
+  Key k = EnvelopeKey(sender_private, recipient_public, salt, kind,
+                      sender_public, recipient_public, &ok);
+  if (!ok) {
+    return {};
+  }
+  // Field order matches Go's encoding/json (struct order); only the bytes
+  // after decryption matter, the receiver parses JSON.
+  base::DictValue dict;
+  dict.Set("vault_uuid", grant.vault_uuid);
+  dict.Set("vault_key", Base64(grant.vault_key));
+  dict.Set("display_name", grant.display_name);
+  if (!grant.replaces_uuid.empty()) {
+    dict.Set("replaces_uuid", grant.replaces_uuid);
+  }
+  std::string json = base::WriteJson(dict).value_or("");
+  std::array<uint8_t, kNonceSize> n =
+      nonce ? *nonce : crypto::RandBytesAsArray<kNonceSize>();
+  std::vector<uint8_t> out(n.begin(), n.end());
+  std::vector<uint8_t> sealed = crypto::aead::Seal(
+      crypto::aead::AES_256_GCM, k, base::as_byte_span(json), n,
+      base::as_byte_span(EnvelopeAd(kind)));
+  Append(out, sealed);
+  return out;
+}
+
+std::optional<VaultGrant> OpenEnvelope(const Key& recipient_private,
+                                       const Key& sender_public,
+                                       base::span<const uint8_t> salt,
+                                       std::string_view kind,
+                                       base::span<const uint8_t> envelope) {
+  if (envelope.size() < kNonceSize + 16) {
+    return std::nullopt;
+  }
+  const Key recipient_public = PublicKeyFor(recipient_private);
+  bool ok = false;
+  Key k = EnvelopeKey(recipient_private, sender_public, salt, kind,
+                      sender_public, recipient_public, &ok);
+  if (!ok) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<uint8_t>> plain = crypto::aead::Open(
+      crypto::aead::AES_256_GCM, k, envelope.subspan(kNonceSize),
+      envelope.first(kNonceSize), base::as_byte_span(EnvelopeAd(kind)));
+  if (!plain) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> value = base::JSONReader::Read(
+      base::as_string_view(*plain), base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value->GetDict();
+  const std::string* uuid = dict.FindString("vault_uuid");
+  const std::string* key = dict.FindString("vault_key");
+  const std::string* name = dict.FindString("display_name");
+  const std::string* replaces = dict.FindString("replaces_uuid");
+  if (!uuid || !key || !IsValidUuid(*uuid)) {
+    return std::nullopt;
+  }
+  std::optional<Key> vault_key = KeyFromBase64(*key);
+  if (!vault_key) {
+    return std::nullopt;
+  }
+  VaultGrant grant;
+  grant.vault_uuid = *uuid;
+  grant.vault_key = *vault_key;
+  grant.display_name = name ? *name : std::string();
+  grant.replaces_uuid = replaces ? *replaces : std::string();
+  return grant;
+}
+
+std::string EncodeRecoveryKey(const Key& vault_key) {
+  std::vector<uint8_t> raw(vault_key.begin(), vault_key.end());
+  auto sum = crypto::hash::Sha256(vault_key);
+  raw.push_back(sum[0]);
+  raw.push_back(sum[1]);
+  std::string s = Base32NoPad(raw);
+  std::string out = kRecoveryTag;
+  for (size_t i = 0; i < s.size(); i += 5) {
+    out += "-" + s.substr(i, 5);
+  }
+  return out;
+}
+
+std::optional<Key> DecodeRecoveryKey(std::string_view text) {
+  std::string s;
+  for (char c : text) {
+    if (!base::IsAsciiWhitespace(c) && c != '-') {
+      s.push_back(base::ToUpperASCII(c));
+    }
+  }
+  if (base::StartsWith(s, kRecoveryTag)) {
+    s = s.substr(strlen(kRecoveryTag));
+  }
+  // Common misreadings.
+  for (char& c : s) {
+    if (c == '0') c = 'O';
+    if (c == '1') c = 'I';
+    if (c == '8') c = 'B';
+  }
+  std::optional<std::vector<uint8_t>> raw = FromBase32NoPad(s);
+  if (!raw || raw->size() != kKeySize + 2) {
+    return std::nullopt;
+  }
+  Key key;
+  std::copy(raw->begin(), raw->begin() + kKeySize, key.begin());
+  auto sum = crypto::hash::Sha256(key);
+  if (sum[0] != (*raw)[kKeySize] || sum[1] != (*raw)[kKeySize + 1]) {
+    return std::nullopt;
+  }
+  return key;
+}
+
+ObjectCrypto::ObjectCrypto(const Key& vault_key, std::string vault_uuid)
+    : object_key_(crypto::kdf::Hkdf<kKeySize>(
+          crypto::hash::kSha256,
+          vault_key,
+          base::as_byte_span(vault_uuid),
+          base::as_byte_span(std::string_view(kObjectKeyInfo)))),
+      vault_uuid_(std::move(vault_uuid)) {}
+
+ObjectCrypto::~ObjectCrypto() = default;
+
+std::vector<uint8_t> ObjectCrypto::AssociatedData(uint8_t role) const {
+  std::vector<uint8_t> ad;
+  Append(ad, kObjectAdPrefix);
+  Append(ad, vault_uuid_);
+  ad.push_back(role);
+  return ad;
+}
+
+std::vector<uint8_t> ObjectCrypto::Encrypt(
+    uint8_t role,
+    base::span<const uint8_t> plaintext,
+    std::optional<std::array<uint8_t, 12>> nonce) const {
+  std::array<uint8_t, kNonceSize> n =
+      nonce ? *nonce : crypto::RandBytesAsArray<kNonceSize>();
+  std::vector<uint8_t> out(n.begin(), n.end());
+  Append(out, crypto::aead::Seal(crypto::aead::AES_256_GCM_SIV, object_key_,
+                                 plaintext, n, AssociatedData(role)));
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> ObjectCrypto::Decrypt(
+    uint8_t role,
+    base::span<const uint8_t> container) const {
+  if (container.size() < kNonceSize + 16) {
+    return std::nullopt;
+  }
+  return crypto::aead::Open(crypto::aead::AES_256_GCM_SIV, object_key_,
+                            container.subspan(kNonceSize),
+                            container.first(kNonceSize), AssociatedData(role));
+}
+
+std::string Base64(base::span<const uint8_t> data) {
+  return base::Base64Encode(data);
+}
+
+std::optional<std::vector<uint8_t>> FromBase64(std::string_view text) {
+  return base::Base64Decode(text);
+}
+
+std::optional<Key> KeyFromBase64(std::string_view text) {
+  std::optional<std::vector<uint8_t>> raw = FromBase64(text);
+  if (!raw || raw->size() != kKeySize) {
+    return std::nullopt;
+  }
+  Key key;
+  std::copy(raw->begin(), raw->end(), key.begin());
+  return key;
+}
+
+}  // namespace corvid_sync
