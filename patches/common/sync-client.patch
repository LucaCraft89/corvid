+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#ifndef COMPONENTS_CORVID_SYNC_HTTP_H_
+#define COMPONENTS_CORVID_SYNC_HTTP_H_
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/synchronization/lock.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/thread_annotations.h"
+#include "components/sync/engine/cancelation_signal.h"
+
+namespace network {
+class PendingSharedURLLoaderFactory;
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace corvid_sync {
+
+struct HttpRequest {
+  std::string method;  // GET, PUT, POST, DELETE
+  std::string url;
+  std::vector<std::pair<std::string, std::string>> headers;
+  std::string body;
+  std::string content_type;
+};
+
+struct HttpResponse {
+  // 0 when the request did not get an HTTP answer (network error, abort).
+  int status = 0;
+  bool aborted = false;
+  std::string body;
+  std::string etag;
+};
+
+// Synchronous HTTP for the sync thread and the account task runner. Each call
+// blocks the calling sequence until the answer arrives.
+class BlockingHttp {
+ public:
+  virtual ~BlockingHttp() = default;
+  virtual HttpResponse Send(const HttpRequest& request) = 0;
+  // Makes Send() return `aborted` from now on, also from another sequence.
+  virtual void SetCancelationSignal(syncer::CancelationSignal* signal) {}
+};
+
+// Real implementation: SimpleURLLoader on its own sequence, like Chromium's
+// HttpBridge. No cookies, no credentials other than the bearer header.
+class UrlLoaderBlockingHttp : public BlockingHttp,
+                              public syncer::CancelationSignal::Observer {
+ public:
+  explicit UrlLoaderBlockingHttp(
+      std::unique_ptr<network::PendingSharedURLLoaderFactory> pending_factory);
+  ~UrlLoaderBlockingHttp() override;
+
+  HttpResponse Send(const HttpRequest& request) override;
+  void SetCancelationSignal(syncer::CancelationSignal* signal) override;
+
+  // syncer::CancelationSignal::Observer:
+  void OnCancelationSignalReceived() override;
+
+ private:
+  class Core;
+
+  scoped_refptr<base::SequencedTaskRunner> network_runner_;
+  scoped_refptr<Core> core_;
+  raw_ptr<syncer::CancelationSignal> signal_ = nullptr;
+};
+
+}  // namespace corvid_sync
+
+#endif  // COMPONENTS_CORVID_SYNC_HTTP_H_
