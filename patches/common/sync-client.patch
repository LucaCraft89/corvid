+class CorvidSyncAccountTest : public testing::Test {
+ protected:
+  // Sets up `first`, invites `second`, compares codes and approves.
+  void Pair(Account& approver, Account& joiner, const std::string& name) {
+    auto code = approver.CreateInvite();
+    ASSERT_TRUE(code.has_value());
+    ASSERT_TRUE(joiner.Join(kTestServerUrl, *code, name).has_value());
+    EXPECT_EQ(joiner.state().join_approver, approver.state().device_id);
+    EXPECT_FALSE(joiner.state().has_vault());
+    ASSERT_TRUE(approver.ProcessMessages().has_value());
+    ASSERT_EQ(approver.pairings().size(), 1u);
+    const Pairing pairing = approver.pairings().begin()->second;
+    EXPECT_EQ(pairing.name, name);
+    auto shown = joiner.JoinComparisonCode();
+    ASSERT_TRUE(shown.has_value());
+    EXPECT_EQ(*shown, pairing.code);
+    EXPECT_EQ(shown->size(), 6u);
+    ASSERT_TRUE(approver.Approve(pairing.device_id).has_value());
+    auto joined = joiner.ProcessMessages();
+    ASSERT_TRUE(joined.has_value());
+    EXPECT_TRUE(*joined);
+  }
+
+  // A real engine snapshot through Helium's store: what the browser writes.
+  void CommitSnapshot(const Account& account) {
+    auto store = MakeStore(account);
+    auto base = store->ReadState();
+    ASSERT_TRUE(base.has_value());
+    syncer::LoopbackServer loopback;
+    loopback.EnableStrongConsistencyWithConflictDetectionModel();
+    // The first command makes the permanent entities.
+    sync_pb::ClientToServerMessage message;
+    message.set_share("test");
+    message.set_message_contents(sync_pb::ClientToServerMessage::GET_UPDATES);
+    message.mutable_get_updates()->add_from_progress_marker()
+        ->set_data_type_id(32904);  // Bookmarks.
+    sync_pb::ClientToServerResponse response;
+    ASSERT_EQ(loopback.HandleCommandWithResult(message, &response).status, 200);
+    auto snapshot = loopback.SerializeStateToBytes();
+    ASSERT_TRUE(snapshot);
+    snapshot_ = *snapshot;
+    auto committed = store->CommitMutation(*base, std::nullopt, *snapshot);
+    ASSERT_TRUE(committed.has_value()) << static_cast<int>(committed.error());
+  }
+
+  std::unique_ptr<syncer::SyncVaultStore> MakeStore(const Account& account) {
+    class Lent : public BlockingHttp {
+     public:
+      explicit Lent(BlockingHttp* http) : http_(http) {}
+      HttpResponse Send(const HttpRequest& request) override {
+        return http_->Send(request);
+      }
+      raw_ptr<BlockingHttp> http_;
+    };
+    auto store = syncer::SyncVaultStore::Create(
+        std::make_unique<ServerVaultTransport>(
+            std::make_unique<Lent>(&server_), kTestServerUrl,
+            account.state().device_secret, account.state().vault_uuid),
+        std::make_unique<syncer::LoopbackServerStateCodec>(),
+        account.state().vault_key, account.state().vault_uuid, std::nullopt,
+        base::BindRepeating(
+            [](const syncer::SyncVaultCheckpoint&) { return true; }));
+    EXPECT_TRUE(store.has_value());
+    return std::move(store.value());
+  }
+
+  std::string Vault(const Account& account) {
+    return account.state().vault_uuid;
+  }
+
+  TestServer server_;
+  std::vector<uint8_t> snapshot_;
+};
