+  auto bad = other.Recover(kTestServerUrl, token, "r",
+                           EncodeRecoveryKey(RandomKey()));
+  ASSERT_FALSE(bad.has_value());
+  EXPECT_TRUE(bad.error().integrity);
+  EXPECT_FALSE(other.state().has_vault());
+
+  // The right key works, without spending a second token.
+  ASSERT_TRUE(other.Recover(kTestServerUrl, "ignored", "r", *key).has_value());
+  EXPECT_EQ(other.state().vault_key, a.state().vault_key);
+  EXPECT_TRUE(other.state().roster->IsActive(other.state().device_id));
+  EXPECT_EQ(other.state().roster->Find(other.state().device_id)->added_by,
