+#ifndef COMPONENTS_CORVID_SYNC_TEST_SERVER_H_
+#define COMPONENTS_CORVID_SYNC_TEST_SERVER_H_
+
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "components/corvid_sync/http.h"
+
+namespace corvid_sync {
+
+inline constexpr char kTestServerUrl[] = "https://sync.test";
+
+// The server's rules from SPEC.md section 3, in memory, one account. The real
+// server is tested in sync/; this lets the client tests also act as a
+// malicious server (`vaults` is open for tampering).
+class TestServer : public BlockingHttp {
+ public:
+  struct Object {
+    std::string data;
+    std::string revision;
+  };
+  struct Device {
+    std::string name;
+    std::string public_key;
+    std::string secret;
+    bool revoked = false;
+  };
+  struct Mail {
+    int64_t id;
+    std::string to, from, kind, data;
+  };
+
+  TestServer();
+  ~TestServer() override;
+
+  std::string AddToken();
+  HttpResponse Send(const HttpRequest& request) override;
+
+  // When true, every request fails like a network outage.
+  bool offline = false;
+  int request_count = 0;
+  std::map<std::string, std::map<std::string, Object>> vaults;
+  std::map<std::string, Device> devices;
+  std::vector<Mail> mail;
+  std::set<std::string> tokens;
+
+ private:
+  HttpResponse Handle(const HttpRequest& request);
+  std::string NextRevision();
+  int next_ = 1;
+};
+
+}  // namespace corvid_sync
+
+#endif  // COMPONENTS_CORVID_SYNC_TEST_SERVER_H_
