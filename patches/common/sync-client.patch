+// Result of one operation on the worker, for the UI sequence.
+struct OpResult {
+  OpResult();
+  OpResult(OpResult&&);
+  OpResult& operator=(OpResult&&);
+  ~OpResult();
+
+  std::optional<AccountError> error;
+  DeviceState state;
+  std::optional<syncer::SyncVaultCheckpoint> checkpoint;
+  bool vault_changed = false;
+  // Shown once, not kept in the view.
+  std::string recovery_key;
+  std::string invite_code;
+  // Comparison code on the new device; pending pairings; device list.
+  std::string join_code;
+  base::ListValue pairings;
+  std::optional<base::ListValue> devices;
+};
+
+// The profile's sync account: runs account operations off the UI thread,
+// saves their results, restarts the sync engine when the vault changes, and
+// polls the mailbox and the vault head. Does nothing until sync is set up.
+class Service : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // `transient` holds one-time answers: "recoveryKey", "inviteCode",
+    // "error", "integrity".
+    virtual void OnSyncViewChanged(const base::DictValue& view,
+                                   const base::DictValue& transient) = 0;
+  };
+
+  Service(PrefService* prefs,
+          scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+          os_crypt_async::OSCryptAsync* os_crypt,
+          syncer::SyncService* sync_service);
+  Service(const Service&) = delete;
+  Service& operator=(const Service&) = delete;
+  ~Service() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Sends the view to observers after refreshing it from the server.
+  void Refresh();
+  void CreateVault(std::string server, std::string token, std::string name);
+  void Join(std::string server, std::string code, std::string name);
+  void Recover(std::string server,
+               std::string token,
+               std::string name,
+               std::string recovery_key);
+  void CreateInvite();
+  void Approve(std::string device_id);
+  void Reject(std::string device_id);
+  void RemoveDevice(std::string device_id);
+  void ShowRecoveryKey();
+  void TurnOff();
+
+  base::DictValue View() const;
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  class Worker;
+  using Op = base::OnceCallback<void(Account&, OpResult&)>;
+
+  void OnEncryptor(scoped_refptr<os_crypt_async::Encryptor> encryptor);
+  void Run(Op op);
+  void OnDone(OpResult result);
+  void Poll();
+  void UpdateTimer();
+
+  const raw_ptr<PrefService> prefs_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  const raw_ptr<syncer::SyncService> sync_service_;
+  scoped_refptr<os_crypt_async::Encryptor> encryptor_;
+  base::SequenceBound<Worker> worker_;
+  DeviceState state_;
+  std::string join_code_;
+  base::ListValue pairings_;
+  base::ListValue devices_;
+  std::string load_error_;
+  int ops_in_flight_ = 0;
+  base::RepeatingTimer poll_timer_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<Service> weak_factory_{this};
+};
