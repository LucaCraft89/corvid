+TEST_F(CorvidSyncAccountTest, RemoveDeviceRotates) {
+  Account a(&server_, DeviceState());
+  ASSERT_TRUE(a.CreateVault(kTestServerUrl, server_.AddToken(), "a").has_value());
+  Account b(&server_, DeviceState());
+  Account c(&server_, DeviceState());
+  ASSERT_NO_FATAL_FAILURE(Pair(a, b, "b"));
+  ASSERT_NO_FATAL_FAILURE(Pair(a, c, "c"));
+  ASSERT_NO_FATAL_FAILURE(CommitSnapshot(a));
+  ASSERT_TRUE(b.RefreshRoster().has_value());
+  const std::string old_uuid = Vault(a);
+  const Key old_key = a.state().vault_key;
+
+  auto new_key = a.RemoveDevice(c.state().device_id);
+  ASSERT_TRUE(new_key.has_value()) << new_key.error().text;
+  EXPECT_NE(a.state().vault_key, old_key);
+  EXPECT_NE(Vault(a), old_uuid);
+  EXPECT_EQ(DecodeRecoveryKey(*new_key), a.state().vault_key);
+  EXPECT_EQ(server_.vaults.count(old_uuid), 0u);
+  EXPECT_FALSE(a.state().roster->Find(c.state().device_id));
+
+  // The data moved over.
+  auto moved = MakeStore(a)->ReadState();
+  ASSERT_TRUE(moved.has_value());
+  EXPECT_EQ(moved->data(), snapshot_);
+
+  // b follows, with the old vault already gone.
+  auto followed = b.ProcessMessages();
+  ASSERT_TRUE(followed.has_value()) << followed.error().text;
+  EXPECT_TRUE(*followed);
+  EXPECT_EQ(b.state().vault_key, a.state().vault_key);
+  EXPECT_EQ(Vault(b), Vault(a));
+
+  // c is out: 401, and no key arrives.
+  auto refused = c.ProcessMessages();
+  ASSERT_FALSE(refused.has_value());
+  EXPECT_TRUE(refused.error().revoked);
+  EXPECT_TRUE(c.state().revoked);
+  EXPECT_EQ(c.state().vault_key, old_key);
+}
