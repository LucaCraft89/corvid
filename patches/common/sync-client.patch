+#include "crypto/secure_util.h"
+
+namespace corvid_sync {
+
+namespace {
+
+constexpr int64_t kInviteTtlSeconds = 60 * 60;
+constexpr int kMaxRosterAttempts = 8;
+constexpr size_t kMaxRosterBytes =
+    syncer::kSyncVaultMaximumMetadataPlaintextBytes +
+    syncer::kSyncVaultContainerOverheadBytes;
+
+AccountError FromApi(const ApiError& error) {
+  return AccountError{.text = ApiErrorText(error),
+                      .revoked = error.kind == ApiError::Kind::kRevoked};
+}
+
+AccountError Integrity(std::string text) {
+  return AccountError{.text = std::move(text), .integrity = true};
+}
+
+AccountError Input(std::string text) {
+  return AccountError{.text = std::move(text)};
+}
+
+// The Account's connection, lent to a vault store for one operation.
+class BorrowedHttp : public BlockingHttp {
+ public:
+  explicit BorrowedHttp(BlockingHttp* http) : http_(http) {}
+  HttpResponse Send(const HttpRequest& request) override {
+    return http_->Send(request);
+  }
+
+ private:
+  const raw_ptr<BlockingHttp> http_;
+};
+
+std::string StoreErrorText(syncer::SyncVaultStoreError error) {
+  using E = syncer::SyncVaultStoreError;
+  switch (error) {
+    case E::kRollback:
+      return "The server returned older data than this device already saw.";
+    case E::kFork:
+      return "The server returned a different history than this device saw.";
+    case E::kAuthenticationFailed:
+    case E::kInvalidVaultKey:
+    case E::kMalformedObject:
+      return "The data on the server failed its integrity check.";
+    case E::kNetworkError:
+    case E::kTemporaryError:
+      return "Cannot reach the sync server.";
+    case E::kConflict:
+      return "Changed on the server at the same time; try again.";
+    case E::kQuotaExceeded:
+      return "The account is full on the server.";
+    default:
+      return "The vault could not be read or written.";
+  }
+}
+
+bool IsIntegrity(syncer::SyncVaultStoreError error) {
+  using E = syncer::SyncVaultStoreError;
+  return error == E::kRollback || error == E::kFork ||
+         error == E::kAuthenticationFailed || error == E::kMalformedObject;
+}
+
+AccountError FromStore(syncer::SyncVaultStoreError error) {
+  return AccountError{.text = StoreErrorText(error),
+                      .integrity = IsIntegrity(error)};
+}
+
+using PersistCallback = syncer::SyncVaultStore::PersistCheckpointCallback;
+
+base::expected<std::unique_ptr<syncer::SyncVaultStore>, AccountError> MakeStore(
+    BlockingHttp* http,
+    const std::string& server_url,
+    const std::string& secret,
+    const std::string& uuid,
+    const Key& key,
+    std::optional<syncer::SyncVaultCheckpoint> checkpoint,
+    PersistCallback persist) {
+  auto store = syncer::SyncVaultStore::Create(
+      std::make_unique<ServerVaultTransport>(
+          std::make_unique<BorrowedHttp>(http), server_url, secret, uuid),
+      std::make_unique<syncer::LoopbackServerStateCodec>(), key, uuid,
+      std::move(checkpoint), std::move(persist));
+  if (!store.has_value()) {
+    return base::unexpected(FromStore(store.error()));
+  }
+  return std::move(store.value());
+}
+
+}  // namespace
+
+std::string DeviceState::ToJson() const {
+  base::DictValue d;
+  d.Set("server_url", server_url);
+  d.Set("account", account);
+  d.Set("device_id", device_id);
+  d.Set("device_name", device_name);
+  d.Set("device_secret", device_secret);
+  d.Set("identity", Base64(identity));
+  d.Set("vault_uuid", vault_uuid);
+  d.Set("vault_name", vault_name);
+  d.Set("vault_key", Base64(vault_key));
+  d.Set("roster_version", base::NumberToString(roster_version));
+  if (roster) {
+    d.Set("roster", roster->ToJson());
+  }
+  if (join_secret) {
+    d.Set("join_secret", Base64(*join_secret));
+    d.Set("join_approver", join_approver);
+  }
+  d.Set("revoked", revoked);
+  return base::WriteJson(d).value_or(std::string());
+}
+
+// static
+std::optional<DeviceState> DeviceState::FromJson(std::string_view json) {
+  std::optional<base::Value> value =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& d = value->GetDict();
+  auto str = [&d](std::string_view key) {
+    const std::string* s = d.FindString(key);
+    return s ? *s : std::string();
+  };
+  DeviceState state;
+  state.server_url = str("server_url");
+  state.account = str("account");
+  state.device_id = str("device_id");
+  state.device_name = str("device_name");
+  state.device_secret = str("device_secret");
+  state.vault_uuid = str("vault_uuid");
+  state.vault_name = str("vault_name");
+  state.join_approver = str("join_approver");
+  std::optional<Key> identity = KeyFromBase64(str("identity"));
+  std::optional<Key> vault_key = KeyFromBase64(str("vault_key"));
+  if (!identity || !vault_key ||
+      !base::StringToUint64(str("roster_version"), &state.roster_version)) {
+    return std::nullopt;
+  }
+  state.identity = *identity;
+  state.vault_key = *vault_key;
+  if (d.contains("roster")) {
+    state.roster = Roster::FromJson(str("roster"));
+    if (!state.roster) {
+      return std::nullopt;
+    }
+  }
+  if (d.contains("join_secret")) {
+    state.join_secret = KeyFromBase64(str("join_secret"));
+    if (!state.join_secret) {
+      return std::nullopt;
+    }
+  }
+  state.revoked = d.FindBool("revoked").value_or(false);
+  return state;
+}
+
+Account::Account(BlockingHttp* http, DeviceState state)
+    : http_(http), state_(std::move(state)) {}
+
+Account::~Account() = default;
+
+Account::Status Account::Register(std::string_view server_url,
+                                  std::string_view token,
+                                  std::string_view device_name) {
+  if (state_.registered()) {
+    // A try that failed after registering: the token is already spent.
+    if (!state_.has_vault() && !state_.join_secret) {
+      return base::ok();
+    }
+    return base::unexpected(Input("Sync is already set up on this device."));
+  }
+  const std::string url = NormalizeServerUrl(server_url);
+  if (url.empty()) {
+    return base::unexpected(Input(
+        "The server address must start with https:// (plain http:// only for "
+        "this computer)."));
+  }
+  const Key identity = NewPrivateKey();
+  ApiClient api(http_, url, std::string());
+  auto reg = api.Register(token, device_name, PublicKeyFor(identity));
+  if (!reg.has_value()) {
+    return base::unexpected(FromApi(reg.error()));
+  }
+  state_ = DeviceState();
+  state_.server_url = url;
+  state_.account = reg->account;
+  state_.device_id = reg->device_id;
+  state_.device_name = std::string(device_name);
+  state_.device_secret = reg->device_secret;
+  state_.identity = identity;
+  return base::ok();
+}
+
+Account::Status Account::InitializeVault(std::string_view uuid,
+                                         const Key& key) {
+  ASSIGN_OR_RETURN(
+      std::unique_ptr<syncer::SyncVaultStore> store,
+      MakeStore(http_, state_.server_url, state_.device_secret,
+                std::string(uuid), key, std::nullopt,
+                base::BindRepeating(
+                    [](const syncer::SyncVaultCheckpoint&) { return true; })));
+  auto read = store->InitializeEmptyVaultAndReadState();
+  if (!read.has_value()) {
+    return base::unexpected(FromStore(read.error()));
+  }
+  return base::ok();
+}
+
+Account::Result<std::string> Account::CreateVault(
+    std::string_view server_url,
+    std::string_view token,
+    std::string_view device_name) {
+  RETURN_IF_ERROR(Register(server_url, token, device_name));
+  const std::string uuid = NewVaultUuid();
+  const Key key = RandomKey();
+  const std::string name = "Corvid";
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto put = api.PutVault(uuid, name);
+  if (!put.has_value()) {
+    return base::unexpected(FromApi(put.error()));
+  }
+  RETURN_IF_ERROR(InitializeVault(uuid, key));
+  Adopt(VaultGrant{uuid, key, name, std::string()});
+  const std::string self = state_.device_id;
+  const std::string self_name = state_.device_name;
+  const Key self_public = PublicKeyFor(state_.identity);
+  RETURN_IF_ERROR(UpdateRoster(uuid, key, [&](Roster& r) {
+    r.devices.push_back(RosterEntry{self, self_name, self_public, self});
+  }));
+  return EncodeRecoveryKey(key);
+}
+
+Account::Status Account::Join(std::string_view server_url,
+                              std::string_view invite_code,
+                              std::string_view device_name) {
+  std::vector<std::string> parts = base::SplitString(
+      invite_code, "~", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  std::string secret_bytes;
+  if (parts.size() != 3 ||
+      !base::Base64UrlDecode(parts[1],
+                             base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                             &secret_bytes) ||
+      secret_bytes.size() != kKeySize) {
+    return base::unexpected(Input("That invite code is not complete."));
+  }
+  Key secret;
+  std::copy(secret_bytes.begin(), secret_bytes.end(), secret.begin());
+  RETURN_IF_ERROR(Register(server_url, parts[0], device_name));
+  state_.join_secret = secret;
+  state_.join_approver = parts[2];
+  base::DictValue body;
+  body.Set("proof", Base64(PairProof(secret, PublicKeyFor(state_.identity))));
+  const std::string json = base::WriteJson(body).value_or("{}");
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  // The server's "data" is []byte; the payload here is JSON, as in Go.
+  auto sent =
+      api.PostMessage(parts[2], kKindPairRequest, base::as_byte_span(json));
+  if (!sent.has_value()) {
+    return base::unexpected(FromApi(sent.error()));
+  }
+  return base::ok();
+}
+
+Account::Result<Key> Account::ServerPublicKey(std::string_view device_id,
+                                              std::string* name) {
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto devices = api.Devices();
+  if (!devices.has_value()) {
+    return base::unexpected(FromApi(devices.error()));
+  }
+  for (const DeviceInfo& d : *devices) {
+    if (d.id == device_id && !d.revoked) {
+      if (name) {
+        *name = d.name;
+      }
+      return d.public_key;
+    }
+  }
+  return base::unexpected(Input("That device is not on the server."));
+}
+
+Account::Result<std::string> Account::JoinComparisonCode() {
+  if (!state_.join_secret) {
+    return base::unexpected(Input("Not pairing."));
+  }
+  ASSIGN_OR_RETURN(Key approver,
+                   ServerPublicKey(state_.join_approver, nullptr));
+  return ComparisonCode(*state_.join_secret, approver,
+                        PublicKeyFor(state_.identity));
+}
+
+Account::Status Account::Recover(std::string_view server_url,
+                                 std::string_view token,
+                                 std::string_view device_name,
+                                 std::string_view recovery_key) {
+  std::optional<Key> key = DecodeRecoveryKey(recovery_key);
+  if (!key) {
+    return base::unexpected(
+        Input("That recovery key has a typo (its checksum does not match)."));
+  }
+  RETURN_IF_ERROR(Register(server_url, token, device_name));
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto vaults = api.Vaults();
+  if (!vaults.has_value()) {
+    return base::unexpected(FromApi(vaults.error()));
+  }
+  for (const VaultInfo& v : *vaults) {
+    auto head = api.ReadObject(v.uuid, "head", kMaxRosterBytes);
+    if (!head.has_value() || !head.value()) {
+      continue;
+    }
+    ObjectCrypto crypto(*key, v.uuid);
+    if (!crypto.Decrypt(/*role=head*/ 1, head.value()->data)) {
+      continue;  // Not this vault.
+    }
+    Adopt(VaultGrant{v.uuid, *key, v.display_name, std::string()});
+    const std::string self = state_.device_id;
+    const std::string self_name = state_.device_name;
+    const Key self_public = PublicKeyFor(state_.identity);
+    return UpdateRoster(v.uuid, *key, [&](Roster& r) {
+      if (!r.Find(self)) {
+        r.devices.push_back(
+            RosterEntry{self, self_name, self_public, "recovery-key"});
+      }
+    });
+  }
+  return base::unexpected(
+      Integrity("That recovery key opens none of this account's vaults."));
+}
+
+Account::Result<std::string> Account::CreateInvite() {
+  if (!state_.has_vault()) {
+    return base::unexpected(Input("This device has no vault key yet."));
+  }
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto token = api.CreateInvite(kInviteTtlSeconds);
+  if (!token.has_value()) {
+    return base::unexpected(FromApi(token.error()));
+  }
+  const Key secret = RandomKey();
+  invites_[*token] = secret;
+  std::string encoded;
+  base::Base64UrlEncode(secret, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &encoded);
+  return *token + "~" + encoded + "~" + state_.device_id;
+}
+
+Account::Status Account::Approve(std::string_view device_id) {
+  auto it = pairings_.find(std::string(device_id));
+  if (it == pairings_.end()) {
+    return base::unexpected(Input("That device is no longer waiting."));
+  }
+  const Pairing pairing = it->second;
+  const std::string self = state_.device_id;
+  RETURN_IF_ERROR(
+      UpdateRoster(state_.vault_uuid, state_.vault_key, [&](Roster& r) {
+        if (!r.Find(pairing.device_id)) {
+          r.devices.push_back(RosterEntry{pairing.device_id, pairing.name,
+                                          pairing.public_key, self});
+        }
+      }));
+  std::vector<uint8_t> envelope = SealEnvelope(
+      state_.identity, pairing.public_key, pairing.secret, kKindVaultKey,
+      VaultGrant{state_.vault_uuid, state_.vault_key, state_.vault_name,
+                 std::string()});
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto sent = api.PostMessage(pairing.device_id, kKindVaultKey, envelope);
+  if (!sent.has_value()) {
+    return base::unexpected(FromApi(sent.error()));
+  }
+  pairings_.erase(it);
+  return base::ok();
+}
+
+void Account::Reject(std::string_view device_id) {
+  auto it = pairings_.find(std::string(device_id));
+  if (it == pairings_.end()) {
+    return;
+  }
+  pairings_.erase(it);
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  std::ignore = api.RevokeDevice(device_id);
+}
+
+void Account::Adopt(const VaultGrant& grant) {
+  state_.vault_uuid = grant.vault_uuid;
+  state_.vault_key = grant.vault_key;
+  state_.vault_name = grant.display_name;
+  state_.roster_version = 0;
+  state_.roster.reset();
+  checkpoint_.reset();
+}
+
+Account::Result<Roster> Account::ReadRoster(
+    std::string_view uuid,
+    const Key& key,
+    uint64_t min_version,
+    std::optional<std::string>* revision) {
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto object = api.ReadObject(uuid, kRosterObjectId, kMaxRosterBytes);
+  if (!object.has_value()) {
+    return base::unexpected(FromApi(object.error()));
+  }
+  if (!object.value()) {
+    if (revision) {
+      revision->reset();
+    }
+    if (min_version > 0) {
+      return base::unexpected(Integrity("The device list is gone."));
+    }
+    return Roster();
+  }
+  ObjectCrypto crypto(key, std::string(uuid));
+  std::optional<std::vector<uint8_t>> plain =
+      crypto.Decrypt(ObjectCrypto::kRoleRoster, object.value()->data);
+  if (!plain) {
+    return base::unexpected(
+        Integrity("The device list failed its integrity check."));
+  }
+  std::optional<Roster> roster = Roster::FromJson(base::as_string_view(*plain));
+  if (!roster) {
+    return base::unexpected(Integrity("The device list could not be read."));
+  }
+  if (roster->version < min_version) {
+    return base::unexpected(
+        Integrity("The server returned an older device list than this device "
+                  "already saw."));
+  }
+  if (revision) {
+    *revision = object.value()->revision;
+  }
+  return *roster;
+}
+
+template <typename Fn>
+Account::Status Account::UpdateRoster(std::string_view uuid,
+                                      const Key& key,
+                                      Fn fn) {
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  ObjectCrypto crypto(key, std::string(uuid));
+  for (int attempt = 0; attempt < kMaxRosterAttempts; ++attempt) {
+    std::optional<std::string> revision;
+    ASSIGN_OR_RETURN(Roster roster, ReadRoster(uuid, key, state_.roster_version,
+                                               &revision));
+    fn(roster);
+    roster.version++;
+    const std::string json = roster.ToJson();
+    auto written =
+        api.WriteObject(uuid, kRosterObjectId, revision,
+                        crypto.Encrypt(ObjectCrypto::kRoleRoster,
+                                       base::as_byte_span(json)),
+                        std::nullopt);
+    if (written.has_value()) {
+      state_.roster_version = roster.version;
+      state_.roster = std::move(roster);
+      return base::ok();
+    }
+    if (written.error().kind != ApiError::Kind::kConflict) {
+      return base::unexpected(FromApi(written.error()));
+    }
+  }
+  return base::unexpected(Input("The device list keeps changing; try again."));
+}
+
+Account::Status Account::RefreshRoster() {
+  if (!state_.has_vault()) {
+    return base::ok();
+  }
+  ASSIGN_OR_RETURN(Roster roster,
+                   ReadRoster(state_.vault_uuid, state_.vault_key,
+                              state_.roster_version, nullptr));
+  state_.roster_version = roster.version;
+  state_.roster = std::move(roster);
+  return base::ok();
+}
+
+Account::Result<std::vector<DeviceRow>> Account::ListDevices() {
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto devices = api.Devices();
+  if (!devices.has_value()) {
+    return base::unexpected(FromApi(devices.error()));
+  }
+  std::vector<DeviceRow> rows;
+  for (const DeviceInfo& d : *devices) {
+    if (d.revoked) {
+      continue;
+    }
+    rows.push_back(DeviceRow{d.id, d.name, d.last_seen,
+                             d.id == state_.device_id,
+                             state_.roster && state_.roster->IsActive(d.id)});
+  }
+  return rows;
+}
+
+Account::Result<std::string> Account::RemoveDevice(std::string_view device_id) {
+  if (!state_.has_vault()) {
+    return base::unexpected(Input("This device has no vault key yet."));
+  }
+  if (device_id == state_.device_id) {
+    return base::unexpected(Input("Use Turn off sync for this device."));
+  }
+  const DeviceState before = state_;
+  const std::string target(device_id);
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto revoked = api.RevokeDevice(target);
+  if (!revoked.has_value()) {
+    return base::unexpected(FromApi(revoked.error()));
+  }
+  RETURN_IF_ERROR(
+      UpdateRoster(state_.vault_uuid, state_.vault_key, [&](Roster& r) {
+        if (RosterEntry* e = r.Find(target)) {
+          e->revoked = true;
+        }
+      }));
+
+  // Latest state of the old vault, verified against our checkpoint.
+  ASSIGN_OR_RETURN(
+      std::unique_ptr<syncer::SyncVaultStore> old_store,
+      MakeStore(http_, state_.server_url, state_.device_secret,
+                state_.vault_uuid, state_.vault_key, checkpoint_,
+                base::BindRepeating(
+                    [](const syncer::SyncVaultCheckpoint&) { return true; })));
+  auto old_state = old_store->ReadState();
+  if (!old_state.has_value()) {
+    return base::unexpected(FromStore(old_state.error()));
+  }
+
+  // New vault with the same data. Nothing the removed device could read from
+  // here on: new key, new name.
+  const std::string new_uuid = NewVaultUuid();
+  const Key new_key = RandomKey();
+  auto put = api.PutVault(new_uuid, state_.vault_name);
+  if (!put.has_value()) {
+    return base::unexpected(FromApi(put.error()));
+  }
+  std::optional<syncer::SyncVaultCheckpoint> new_checkpoint;
+  ASSIGN_OR_RETURN(
+      std::unique_ptr<syncer::SyncVaultStore> new_store,
+      MakeStore(http_, state_.server_url, state_.device_secret, new_uuid,
+                new_key, std::nullopt,
+                base::BindRepeating(
+                    [](std::optional<syncer::SyncVaultCheckpoint>* out,
+                       const syncer::SyncVaultCheckpoint& checkpoint) {
+                      *out = checkpoint;
+                      return true;
+                    },
+                    base::Unretained(&new_checkpoint))));
+  auto base_state = new_store->InitializeEmptyVaultAndReadState();
+  if (!base_state.has_value()) {
+    return base::unexpected(FromStore(base_state.error()));
+  }
+  if (old_state->generation() > 0) {
+    auto committed = new_store->CommitMutation(*base_state, std::nullopt,
+                                               old_state->data());
+    if (!committed.has_value()) {
+      return base::unexpected(FromStore(committed.error()));
+    }
+  }
+
+  // Old roster without revoked devices, in the new vault.
+  Roster old_roster = *state_.roster;
+  const std::string old_uuid = state_.vault_uuid;
+  const Key old_key = state_.vault_key;
+  const std::string name = state_.vault_name;
+  Adopt(VaultGrant{new_uuid, new_key, name, std::string()});
+  Status roster_status = UpdateRoster(new_uuid, new_key, [&](Roster& r) {
+    for (const RosterEntry& e : old_roster.devices) {
+      if (!e.revoked) {
+        r.devices.push_back(e);
+      }
+    }
+  });
+  if (!roster_status.has_value()) {
+    state_ = before;  // Stay on the old vault; it is still there.
+    return base::unexpected(roster_status.error());
+  }
+  checkpoint_ = new_store->checkpoint();
+
+  const Key salt = RotationSalt(old_key, old_uuid);
+  for (const RosterEntry& e : old_roster.devices) {
+    if (e.revoked || e.device_id == state_.device_id) {
+      continue;
+    }
+    std::vector<uint8_t> envelope =
+        SealEnvelope(state_.identity, e.public_key, salt, kKindVaultRotate,
+                     VaultGrant{new_uuid, new_key, name, old_uuid});
+    auto sent = api.PostMessage(e.device_id, kKindVaultRotate, envelope);
+    if (!sent.has_value() && sent.error().kind != ApiError::Kind::kNotFound) {
+      state_ = before;
+      return base::unexpected(FromApi(sent.error()));
+    }
+  }
+  auto deleted = api.DeleteVault(old_uuid);
+  if (!deleted.has_value() && deleted.error().kind != ApiError::Kind::kNotFound) {
+    // Everyone already has the new key. Report it, keep the new vault.
+    LOG(WARNING) << "Corvid sync: old vault not deleted";
+  }
+  return EncodeRecoveryKey(new_key);
+}
+
+Account::Result<bool> Account::ProcessMessages() {
+  if (!state_.registered()) {
+    return false;
+  }
+  ApiClient api(http_, state_.server_url, state_.device_secret);
+  auto messages = api.Messages();
+  if (!messages.has_value()) {
+    if (messages.error().kind == ApiError::Kind::kRevoked) {
+      state_.revoked = true;
+    }
+    return base::unexpected(FromApi(messages.error()));
+  }
+  bool vault_changed = false;
+  std::optional<AccountError> integrity;
+  for (const Message& m : *messages) {
+    Status handled = HandleMessage(m, &vault_changed);
+    if (!handled.has_value()) {
+      if (!handled.error().integrity) {
+        // Transient: keep the message for the next attempt.
+        return base::unexpected(handled.error());
+      }
+      integrity = handled.error();
+    }
+    auto deleted = api.DeleteMessage(m.id);
+    if (!deleted.has_value()) {
+      return base::unexpected(FromApi(deleted.error()));
+    }
+  }
+  if (integrity) {
+    return base::unexpected(*integrity);
+  }
+  return vault_changed;
+}
+
+Account::Status Account::HandleMessage(const Message& m, bool* vault_changed) {
+  if (m.kind == kKindPairRequest) {
+    std::optional<base::Value> value = base::JSONReader::Read(
+        base::as_string_view(m.data), base::JSON_PARSE_RFC);
+    const std::string* proof_text =
+        value && value->is_dict() ? value->GetDict().FindString("proof")
+                                  : nullptr;
+    std::optional<Key> proof =
+        proof_text ? KeyFromBase64(*proof_text) : std::nullopt;
+    if (!proof) {
+      return base::unexpected(Integrity("A pairing request was malformed."));
+    }
+    std::string name;
+    ASSIGN_OR_RETURN(Key pub, ServerPublicKey(m.from_device, &name));
+    for (auto it = invites_.begin(); it != invites_.end(); ++it) {
+      if (crypto::SecureMemEqual(*proof, PairProof(it->second, pub))) {
+        const Key secret = it->second;
+        invites_.erase(it);
+        pairings_[m.from_device] = Pairing{
+            m.from_device, name,
+            ComparisonCode(secret, PublicKeyFor(state_.identity), pub), pub,
+            secret};
+        return base::ok();
+      }
+    }
+    return base::unexpected(
+        Integrity("A pairing request matched no open invite."));
+  }
+
+  if (m.kind == kKindVaultKey) {
+    if (!state_.join_secret || m.from_device != state_.join_approver) {
+      return base::unexpected(Integrity("An unexpected vault key arrived."));
+    }
+    ASSIGN_OR_RETURN(Key pub, ServerPublicKey(m.from_device, nullptr));
+    std::optional<VaultGrant> grant = OpenEnvelope(
+        state_.identity, pub, *state_.join_secret, kKindVaultKey, m.data);
+    if (!grant) {
+      return base::unexpected(
+          Integrity("A vault key failed to authenticate."));
+    }
+    const DeviceState before = state_;
+    Adopt(*grant);
+    Status roster = RefreshRoster();
+    if (roster.has_value() && !(state_.roster &&
+                                state_.roster->IsActive(state_.device_id))) {
+      roster = base::unexpected(
+          Integrity("This device is not in the vault's device list."));
+    }
+    if (!roster.has_value()) {
+      state_ = before;
+      return roster;
+    }
+    state_.join_secret.reset();
+    state_.join_approver.clear();
+    *vault_changed = true;
+    return base::ok();
+  }
+
+  if (m.kind == kKindVaultRotate) {
+    if (!state_.has_vault()) {
+      return base::unexpected(Integrity("A rotation arrived without a vault."));
+    }
+    // The rotating device deletes the old vault: fall back to the last roster
+    // this device authenticated.
+    Status refreshed = RefreshRoster();
+    if (!refreshed.has_value() && refreshed.error().integrity) {
+      return refreshed;
+    }
+    const RosterEntry* sender =
+        state_.roster ? state_.roster->Find(m.from_device) : nullptr;
+    if (!sender || sender->revoked) {
+      return base::unexpected(
+          Integrity("A key rotation came from a device not on the list."));
+    }
+    const Key salt = RotationSalt(state_.vault_key, state_.vault_uuid);
+    std::optional<VaultGrant> grant = OpenEnvelope(
+        state_.identity, sender->public_key, salt, kKindVaultRotate, m.data);
+    if (!grant) {
+      return base::unexpected(
+          Integrity("A key rotation failed to authenticate."));
+    }
+    if (grant->replaces_uuid != state_.vault_uuid) {
+      return base::unexpected(Integrity("A key rotation was for another vault."));
+    }
+    const DeviceState before = state_;
+    const std::optional<syncer::SyncVaultCheckpoint> before_checkpoint =
+        checkpoint_;
+    Adopt(*grant);
+    Status roster = RefreshRoster();
+    if (roster.has_value() && !(state_.roster &&
+                                state_.roster->IsActive(state_.device_id))) {
+      roster = base::unexpected(
+          Integrity("This device is not in the new device list."));
+    }
+    if (!roster.has_value()) {
+      state_ = before;
+      checkpoint_ = before_checkpoint;
+      return roster;
+    }
+    *vault_changed = true;
+    return base::ok();
+  }
+
+  return base::unexpected(Integrity("An unknown message arrived."));
+}
+
+void Account::Leave() {
+  if (state_.has_vault() && !state_.revoked) {
+    const std::string self = state_.device_id;
+    std::ignore =
+        UpdateRoster(state_.vault_uuid, state_.vault_key, [&](Roster& r) {
+          if (RosterEntry* e = r.Find(self)) {
+            e->revoked = true;
+          }
+        });
+  }
+  if (state_.registered() && !state_.revoked) {
+    ApiClient api(http_, state_.server_url, state_.device_secret);
+    std::ignore = api.RevokeDevice(state_.device_id);
+  }
+  state_ = DeviceState();
+  checkpoint_.reset();
+  invites_.clear();
+  pairings_.clear();
+}
+
+std::string Account::RecoveryKey() const {
+  return state_.has_vault() ? EncodeRecoveryKey(state_.vault_key)
+                            : std::string();
+}
+
+}  // namespace corvid_sync
