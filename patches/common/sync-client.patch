+class CorvidSyncTransportTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ApiClient api(&server_, kTestServerUrl, "");
+    auto reg = api.Register(server_.AddToken(), "d", Key{1});
+    ASSERT_TRUE(reg.has_value());
+    device_id_ = reg->device_id;
+    server_.vaults["v"];
