+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#include "components/corvid_sync/server_transport.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace corvid_sync {
+
+using syncer::SyncVaultTransportError;
+
+namespace {
+
+// Helium names objects with base::HexEncode (uppercase); the server's content
+// addresses are lowercase hex (SPEC.md section 3). Names never enter the vault
+// format: commits hold raw digests.
+std::string ServerObjectId(const std::string& object_id) {
+  return base::ToLowerASCII(object_id);
+}
+
+}  // namespace
+
+SyncVaultTransportError ToTransportError(const ApiError& error) {
+  switch (error.kind) {
+    case ApiError::Kind::kNetwork:
+      return SyncVaultTransportError::kNetworkError;
+    case ApiError::Kind::kAborted:
+      return SyncVaultTransportError::kAborted;
+    case ApiError::Kind::kUnauthorized:
+    case ApiError::Kind::kRevoked:
+      return SyncVaultTransportError::kAuthenticationRequired;
+    case ApiError::Kind::kTokenInvalid:
+    case ApiError::Kind::kNotFound:  // The vault itself is gone.
+      return SyncVaultTransportError::kAccessDenied;
+    case ApiError::Kind::kConflict:
+      return SyncVaultTransportError::kConflict;
+    case ApiError::Kind::kQuota:
+      return SyncVaultTransportError::kQuotaExceeded;
+    case ApiError::Kind::kServer:
+      return error.status >= 500 ? SyncVaultTransportError::kTemporaryError
+                                 : SyncVaultTransportError::kInvalidData;
+    case ApiError::Kind::kNoObject:
+    case ApiError::Kind::kTooLarge:
+    case ApiError::Kind::kBadResponse:
+      return SyncVaultTransportError::kInvalidData;
+  }
+  return SyncVaultTransportError::kInvalidData;
+}
+
+ServerVaultTransport::ServerVaultTransport(std::unique_ptr<BlockingHttp> http,
+                                           std::string server_url,
+                                           std::string device_secret,
+                                           std::string vault_uuid)
+    : http_(std::move(http)),
+      api_(http_.get(), std::move(server_url), std::move(device_secret)),
+      vault_uuid_(std::move(vault_uuid)) {}
+
+ServerVaultTransport::~ServerVaultTransport() = default;
+
+void ServerVaultTransport::SetCancelationSignal(
+    syncer::CancelationSignal* signal) {
+  http_->SetCancelationSignal(signal);
+}
+
+ServerVaultTransport::ReadResult ServerVaultTransport::ReadObject(
+    const std::string& object_id,
+    size_t maximum_bytes) {
+  auto r = api_.ReadObject(vault_uuid_, ServerObjectId(object_id),
+                           maximum_bytes);
+  if (!r.has_value()) {
+    return base::unexpected(ToTransportError(r.error()));
+  }
+  if (!r.value()) {
+    return std::nullopt;
+  }
+  return syncer::OpaqueSyncVaultObject{std::move(r.value()->data),
+                                       std::move(r.value()->revision)};
+}
+
+ServerVaultTransport::WriteResult ServerVaultTransport::WriteObject(
+    const std::string& object_id,
+    std::optional<std::string> expected_revision,
+    std::vector<uint8_t> data,
+    std::optional<uint32_t> retention_epoch) {
+  auto r = api_.WriteObject(vault_uuid_, ServerObjectId(object_id),
+                            expected_revision, data, retention_epoch);
+  if (!r.has_value()) {
+    return base::unexpected(ToTransportError(r.error()));
+  }
+  return std::move(r.value());
+}
+
+void ServerVaultTransport::CollectEpochsBefore(uint32_t minimum_retained_epoch,
+                                               CollectCallback callback) {
+  auto r = api_.Collect(vault_uuid_, minimum_retained_epoch);
+  CollectResult result = base::ok();
+  if (!r.has_value()) {
+    result = base::unexpected(ToTransportError(r.error()));
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(callback), result));
+}
+
+}  // namespace corvid_sync
