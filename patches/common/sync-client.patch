+#include "components/corvid_sync/api_client.h"
+
+#include "components/corvid_sync/test_server.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace corvid_sync {
+namespace {
+
+TEST(CorvidSyncApi, NormalizeServerUrl) {
+  EXPECT_EQ(NormalizeServerUrl("https://sync.example.org/"),
+            "https://sync.example.org");
+  EXPECT_EQ(NormalizeServerUrl("  https://sync.example.org:8443/corvid/ "),
+            "https://sync.example.org:8443/corvid");
+  EXPECT_EQ(NormalizeServerUrl("http://127.0.0.1:8443"),
+            "http://127.0.0.1:8443");
+  EXPECT_EQ(NormalizeServerUrl("http://localhost:8443/"),
+            "http://localhost:8443");
+  // Plain HTTP elsewhere would send the device secret in the clear.
+  EXPECT_EQ(NormalizeServerUrl("http://sync.example.org"), "");
+  EXPECT_EQ(NormalizeServerUrl("http://192.168.1.2"), "");
+  EXPECT_EQ(NormalizeServerUrl("ftp://sync.example.org"), "");
+  EXPECT_EQ(NormalizeServerUrl("https://user:pw@sync.example.org"), "");
+  EXPECT_EQ(NormalizeServerUrl("https://sync.example.org/?x=1"), "");
+  EXPECT_EQ(NormalizeServerUrl("nonsense"), "");
+}
+
+class CorvidSyncApiTest : public testing::Test {
+ protected:
+  CorvidSyncApiTest() : api_(&server_, kTestServerUrl, "") {}
+
+  Registration Register() {
+    auto reg = api_.Register(server_.AddToken(), "dev", Key{7});
+    EXPECT_TRUE(reg.has_value());
+    api_.set_secret(reg->device_secret);
+    return *reg;
+  }
+
+  TestServer server_;
+  ApiClient api_;
+};
+
+TEST_F(CorvidSyncApiTest, RegisterSpendsToken) {
+  const std::string token = server_.AddToken();
+  EXPECT_TRUE(api_.Register(token, "a", Key{1}).has_value());
+  auto again = api_.Register(token, "b", Key{2});
+  ASSERT_FALSE(again.has_value());
+  EXPECT_EQ(again.error().kind, ApiError::Kind::kTokenInvalid);
+}
+
+TEST_F(CorvidSyncApiTest, ErrorKinds) {
+  EXPECT_EQ(api_.Devices().error().kind, ApiError::Kind::kUnauthorized);
+  const Registration reg = Register();
+  EXPECT_EQ(api_.ReadObject("nope", "head", 100).error().kind,
+            ApiError::Kind::kNotFound);
+  server_.offline = true;
+  EXPECT_EQ(api_.Devices().error().kind, ApiError::Kind::kNetwork);
+  server_.offline = false;
+  server_.devices[reg.device_id].revoked = true;
+  EXPECT_EQ(api_.Devices().error().kind, ApiError::Kind::kRevoked);
+}
+
+TEST_F(CorvidSyncApiTest, ObjectsAndCompareAndSwap) {
+  Register();
+  ASSERT_TRUE(api_.PutVault("v", "n").has_value());
+  // Absent is not an error.
+  auto absent = api_.ReadObject("v", "head", 100);
+  ASSERT_TRUE(absent.has_value());
+  EXPECT_FALSE(absent->has_value());
+
+  auto rev1 = api_.WriteObject("v", "head", std::nullopt, {1}, std::nullopt);
+  ASSERT_TRUE(rev1.has_value());
+  // Create-only fails when it exists; a stale revision fails.
+  EXPECT_EQ(api_.WriteObject("v", "head", std::nullopt, {2}, std::nullopt)
+                .error()
+                .kind,
+            ApiError::Kind::kConflict);
+  auto rev2 = api_.WriteObject("v", "head", *rev1, {2}, std::nullopt);
+  ASSERT_TRUE(rev2.has_value());
+  EXPECT_EQ(api_.WriteObject("v", "head", *rev1, {3}, std::nullopt)
+                .error()
+                .kind,
+            ApiError::Kind::kConflict);
+  auto read = api_.ReadObject("v", "head", 100);
+  ASSERT_TRUE(read.has_value());
+  EXPECT_EQ(read->value().data, std::vector<uint8_t>{2});
+  EXPECT_EQ(read->value().revision, *rev2);
+  // An answer larger than asked for is refused.
+  EXPECT_EQ(api_.ReadObject("v", "head", 0).error().kind,
+            ApiError::Kind::kBadResponse);
+}
+
+TEST_F(CorvidSyncApiTest, Messages) {
+  const Registration reg = Register();
+  const std::vector<uint8_t> data = {0, 1, 2, 255};
+  ASSERT_TRUE(api_.PostMessage(reg.device_id, "k", data).has_value());
+  auto mail = api_.Messages();
+  ASSERT_TRUE(mail.has_value());
+  ASSERT_EQ(mail->size(), 1u);
+  EXPECT_EQ((*mail)[0].data, data);
+  EXPECT_EQ((*mail)[0].from_device, reg.device_id);
+  ASSERT_TRUE(api_.DeleteMessage((*mail)[0].id).has_value());
+  EXPECT_TRUE(api_.Messages()->empty());
+}
+
