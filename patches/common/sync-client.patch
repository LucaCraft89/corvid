+
+// How often to check the mailbox and pull changes (no push in protocol v1).
+constexpr base::TimeDelta kDefaultPoll = base::Minutes(2);
+constexpr char kPollSwitch[] = "corvid-sync-poll-seconds";
+
+base::TimeDelta PollInterval() {
+  int seconds = 0;
+  if (base::StringToInt(
+          base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+              kPollSwitch),
+          &seconds) &&
+      seconds > 0) {
+    return base::Seconds(seconds);
+  }
+  return kDefaultPoll;
+}
+
+}  // namespace
+
+OpResult::OpResult() = default;
+OpResult::OpResult(OpResult&&) = default;
+OpResult& OpResult::operator=(OpResult&&) = default;
+OpResult::~OpResult() = default;
+
+// Owns the Account and its connection on a worker sequence that may block.
+class Service::Worker {
+ public:
+  Worker(std::unique_ptr<network::PendingSharedURLLoaderFactory> pending,
+         DeviceState state)
+      : http_(std::move(pending)), account_(&http_, std::move(state)) {}
+
+  OpResult Run(Op op, std::optional<syncer::SyncVaultCheckpoint> checkpoint) {
+    OpResult result;
+    const std::string before = account_.state().vault_uuid;
+    if (before.empty() || (checkpoint && checkpoint->vault_uuid == before)) {
+      account_.set_checkpoint(std::move(checkpoint));
+    }
+    std::move(op).Run(account_, result);
+    result.state = account_.state();
+    result.checkpoint = account_.checkpoint();
+    result.vault_changed =
+        result.vault_changed || before != account_.state().vault_uuid;
+    if (account_.state().join_secret) {
+      if (auto code = account_.JoinComparisonCode(); code.has_value()) {
+        result.join_code = *code;
+      }
+    }
+    for (const auto& [id, pairing] : account_.pairings()) {
+      base::DictValue row;
+      row.Set("id", id);
+      row.Set("name", pairing.name);
+      row.Set("code", pairing.code);
+      result.pairings.Append(std::move(row));
+    }
+    return result;
+  }
+
+ private:
+  UrlLoaderBlockingHttp http_;
+  Account account_;
+};
+
+Service::Service(
+    PrefService* prefs,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+    os_crypt_async::OSCryptAsync* os_crypt,
+    syncer::SyncService* sync_service)
+    : prefs_(prefs),
+      url_loader_factory_(std::move(url_loader_factory)),
+      sync_service_(sync_service) {
+  os_crypt->GetInstance(
+      base::BindOnce(&Service::OnEncryptor, weak_factory_.GetWeakPtr()));
+}
+
+Service::~Service() = default;
+
+void Service::Shutdown() {
+  poll_timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  worker_.Reset();
+  url_loader_factory_.reset();
+}
+
+void Service::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void Service::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void Service::OnEncryptor(scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  encryptor_ = std::move(encryptor);
+  if (!prefs_->GetString(kStatePref).empty()) {
+    std::optional<DeviceState> state = LoadState(*prefs_, *encryptor_);
+    if (state) {
+      state_ = std::move(*state);
+    } else {
+      // Keep the pref: the OS keyring may just be locked this time.
+      load_error_ = "The saved sync settings could not be decrypted.";
+    }
+  }
+  worker_ = base::SequenceBound<Worker>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN}),
+      url_loader_factory_->Clone(), state_);
+  UpdateTimer();
+  if (state_.registered()) {
+    Poll();
+  }
+}
+
+void Service::UpdateTimer() {
+  if (state_.registered() && !state_.revoked) {
+    if (!poll_timer_.IsRunning()) {
+      poll_timer_.Start(FROM_HERE, PollInterval(),
+                        base::BindRepeating(&Service::Poll,
+                                            base::Unretained(this)));
+    }
+  } else {
+    poll_timer_.Stop();
+  }
+}
+
+void Service::Run(Op op) {
+  if (!worker_) {
+    return;
+  }
+  std::optional<syncer::SyncVaultCheckpoint> checkpoint;
+  if (encryptor_ && state_.has_vault()) {
+    checkpoint = LoadCheckpoint(*prefs_, *encryptor_, state_.vault_uuid);
+  }
+  ops_in_flight_++;
+  worker_.AsyncCall(&Worker::Run)
+      .WithArgs(std::move(op), std::move(checkpoint))
+      .Then(base::BindOnce(&Service::OnDone, weak_factory_.GetWeakPtr()));
+}
+
+void Service::OnDone(OpResult result) {
+  ops_in_flight_--;
+  const bool was_active = !prefs_->GetString(kVaultPref).empty();
+  const bool was_revoked = prefs_->GetBoolean(kRevokedPref);
+  state_ = std::move(result.state);
+  join_code_ = std::move(result.join_code);
+  pairings_ = std::move(result.pairings);
+  if (result.devices) {
+    devices_ = std::move(*result.devices);
+  }
+  if (encryptor_) {
+    SaveState(prefs_, *encryptor_, state_);
+    if (result.vault_changed) {
+      prefs_->ClearPref(kCheckpointPref);
+      prefs_->ClearPref(kStatusPref);
+      if (result.checkpoint) {
+        SaveCheckpoint(prefs_, *encryptor_, *result.checkpoint);
+      }
+    }
+  }
+  UpdateTimer();
+
+  if (sync_service_) {
+    const bool active = !prefs_->GetString(kVaultPref).empty();
+    if (result.vault_changed || was_active != active ||
+        was_revoked != state_.revoked) {
+      const bool newly_active = active && !was_active;
+      if (newly_active) {
+        sync_service_->GetUserSettings()->SetInitialSyncFeatureSetupComplete();
+      }
+      const bool reconfigured = sync_service_->ReconfigureBackend();
+      if (newly_active && reconfigured) {
+        // Only valid with a backend selected. Same task as the restart above,
+        // so nothing syncs under the default of "everything" first.
+        // What PROJECT.md section 4.6 lists: no open tabs by default.
+        sync_service_->GetUserSettings()->SetSelectedTypes(
+            /*sync_everything=*/false,
+            {syncer::UserSelectableType::kBookmarks,
+             syncer::UserSelectableType::kPreferences,
+             syncer::UserSelectableType::kThemes,
+             syncer::UserSelectableType::kPasswords,
+             syncer::UserSelectableType::kExtensions,
+             syncer::UserSelectableType::kHistory});
+      }
+    }
+  }
+
+  base::DictValue transient;
+  if (!result.recovery_key.empty()) {
+    transient.Set("recoveryKey", result.recovery_key);
+  }
+  if (!result.invite_code.empty()) {
+    transient.Set("inviteCode", result.invite_code);
+  }
+  if (result.error) {
+    transient.Set("error", result.error->text);
+    transient.Set("integrity", result.error->integrity);
+  }
+  const base::DictValue view = View();
+  for (Observer& observer : observers_) {
+    observer.OnSyncViewChanged(view, transient);
+  }
+}
+
+base::DictValue Service::View() const {
+  base::DictValue view;
+  const char* mode = "off";
+  if (state_.revoked) {
+    mode = "revoked";
+  } else if (state_.has_vault()) {
+    mode = "on";
+  } else if (state_.join_secret) {
+    mode = "waiting";
+  }
+  view.Set("mode", mode);
+  view.Set("server", state_.server_url);
+  view.Set("deviceName", state_.device_name);
+  view.Set("deviceId", state_.device_id);
+  view.Set("joinCode", join_code_);
+  view.Set("pairings", pairings_.Clone());
+  view.Set("devices", devices_.Clone());
+  view.Set("status", prefs_->GetDict(kStatusPref).Clone());
+  view.Set("busy", ops_in_flight_ > 0);
+  if (!load_error_.empty()) {
+    view.Set("loadError", load_error_);
+  }
+  return view;
+}
+
+namespace {
+
+// Fills the devices and the roster for the page. A failure here is not worth
+// reporting on top of what the operation itself reported.
+void FillDevices(Account& account, OpResult& result) {
+  if (!account.state().registered() || account.state().revoked) {
+    return;
+  }
+  if (account.state().has_vault()) {
+    std::ignore = account.RefreshRoster();
+  }
+  auto rows = account.ListDevices();
+  if (!rows.has_value()) {
+    return;
+  }
+  base::ListValue list;
+  for (const DeviceRow& row : *rows) {
+    base::DictValue d;
+    d.Set("id", row.id);
+    d.Set("name", row.name);
+    d.Set("lastSeen", base::NumberToString(row.last_seen));
+    d.Set("self", row.is_this_device);
+    d.Set("inRoster", row.in_roster);
+    list.Append(std::move(d));
+  }
+  result.devices = std::move(list);
+}
+
+void ProcessMail(Account& account, OpResult& result) {
+  auto processed = account.ProcessMessages();
+  if (!processed.has_value()) {
+    // Offline is normal; the page shows the engine's status. Tampering is not.
+    if (processed.error().integrity) {
+      result.error = processed.error();
+    }
+    return;
+  }
+  result.vault_changed = processed.value();
+}
+
+}  // namespace
+
+void Service::Poll() {
+  Run(base::BindOnce(&ProcessMail));
+  if (sync_service_ && state_.has_vault() && !state_.revoked) {
+    sync_service_->TriggerRefresh(
+        syncer::SyncService::TriggerRefreshSource::kExtensionSyncProvider,
+        syncer::DataTypeSet::All());
+  }
+}
+
+void Service::Refresh() {
+  Run(base::BindOnce([](Account& account, OpResult& result) {
+    ProcessMail(account, result);
+    FillDevices(account, result);
+  }));
+}
+
+void Service::CreateVault(std::string server,
+                          std::string token,
+                          std::string name) {
+  Run(base::BindOnce(
+      [](std::string server, std::string token, std::string name,
+         Account& account, OpResult& result) {
+        auto key = account.CreateVault(server, token, name);
+        if (key.has_value()) {
+          result.recovery_key = *key;
+          FillDevices(account, result);
+        } else {
+          result.error = key.error();
+        }
+      },
+      std::move(server), std::move(token), std::move(name)));
+}
+
+void Service::Join(std::string server, std::string code, std::string name) {
+  Run(base::BindOnce(
+      [](std::string server, std::string code, std::string name,
+         Account& account, OpResult& result) {
+        auto joined = account.Join(server, code, name);
+        if (!joined.has_value()) {
+          result.error = joined.error();
+        }
+      },
+      std::move(server), std::move(code), std::move(name)));
+}
+
+void Service::Recover(std::string server,
+                      std::string token,
+                      std::string name,
+                      std::string recovery_key) {
+  Run(base::BindOnce(
+      [](std::string server, std::string token, std::string name,
+         std::string recovery_key, Account& account, OpResult& result) {
+        auto recovered = account.Recover(server, token, name, recovery_key);
+        if (recovered.has_value()) {
+          FillDevices(account, result);
+        } else {
+          result.error = recovered.error();
+        }
+      },
+      std::move(server), std::move(token), std::move(name),
+      std::move(recovery_key)));
+}
+
+void Service::CreateInvite() {
+  Run(base::BindOnce([](Account& account, OpResult& result) {
+    auto code = account.CreateInvite();
+    if (code.has_value()) {
+      result.invite_code = *code;
+    } else {
+      result.error = code.error();
+    }
+  }));
+}
+
+void Service::Approve(std::string device_id) {
+  Run(base::BindOnce(
+      [](std::string id, Account& account, OpResult& result) {
+        auto approved = account.Approve(id);
+        if (!approved.has_value()) {
+          result.error = approved.error();
+        }
+        FillDevices(account, result);
+      },
+      std::move(device_id)));
+}
+
+void Service::Reject(std::string device_id) {
+  Run(base::BindOnce(
+      [](std::string id, Account& account, OpResult& result) {
+        account.Reject(id);
+        FillDevices(account, result);
+      },
+      std::move(device_id)));
+}
+
+void Service::RemoveDevice(std::string device_id) {
+  Run(base::BindOnce(
+      [](std::string id, Account& account, OpResult& result) {
+        auto key = account.RemoveDevice(id);
+        if (key.has_value()) {
+          result.recovery_key = *key;
+        } else {
+          result.error = key.error();
+        }
+        FillDevices(account, result);
+      },
+      std::move(device_id)));
+}
+
+void Service::ShowRecoveryKey() {
+  Run(base::BindOnce([](Account& account, OpResult& result) {
+    result.recovery_key = account.RecoveryKey();
+  }));
+}
+
+void Service::TurnOff() {
+  Run(base::BindOnce(
+      [](Account& account, OpResult& result) { account.Leave(); }));
+}
+
+}  // namespace corvid_sync
