+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#ifndef COMPONENTS_CORVID_SYNC_ROSTER_H_
+#define COMPONENTS_CORVID_SYNC_ROSTER_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "components/corvid_sync/keys.h"
+
+namespace corvid_sync {
+
+inline constexpr char kRosterObjectId[] = "roster";
+
+// The devices that hold the vault key (SPEC.md section 4). Stored in the
+// vault as the object "roster", encrypted like the head (role 16).
+struct RosterEntry {
+  std::string device_id;
+  std::string name;
+  Key public_key{};
+  std::string added_by;
+  bool revoked = false;
+
+  bool operator==(const RosterEntry&) const = default;
+};
+
+struct Roster {
+  uint64_t version = 0;
+  std::vector<RosterEntry> devices;
+
+  RosterEntry* Find(std::string_view device_id);
+  const RosterEntry* Find(std::string_view device_id) const;
+  // Listed and not revoked.
+  bool IsActive(std::string_view device_id) const;
+
+  // Same JSON as the Go client (encoding/json of its struct).
+  std::string ToJson() const;
+  static std::optional<Roster> FromJson(std::string_view json);
+
+  bool operator==(const Roster&) const = default;
+};
+
+}  // namespace corvid_sync
+
+#endif  // COMPONENTS_CORVID_SYNC_ROSTER_H_
