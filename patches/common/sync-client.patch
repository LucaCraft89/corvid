+
+TEST_F(CorvidSyncTransportTest, ReadWriteConditional) {
+  auto absent = transport_->ReadObject("head", 100);
+  ASSERT_TRUE(absent.has_value());
+  EXPECT_FALSE(absent->has_value());
+
+  auto rev = transport_->WriteObject("head", std::nullopt, {1}, std::nullopt);
+  ASSERT_TRUE(rev.has_value());
+  auto again = transport_->WriteObject("head", std::nullopt, {2}, std::nullopt);
+  ASSERT_FALSE(again.has_value());
+  EXPECT_EQ(again.error(), SyncVaultTransportError::kConflict);
+  ASSERT_TRUE(transport_->WriteObject("head", *rev, {3}, std::nullopt)
+                  .has_value());
+  auto read = transport_->ReadObject("head", 100);
+  ASSERT_TRUE(read.has_value());
+  EXPECT_EQ(read->value().data, std::vector<uint8_t>{3});
+  EXPECT_FALSE(read->value().revision.empty());
+}
+
+// Helium's object names are uppercase hex; the server wants lowercase.
+TEST_F(CorvidSyncTransportTest, ObjectNamesAreLowercased) {
+  const std::vector<uint8_t> data = {1, 2, 3};
+  const std::string upper = base::HexEncode(crypto::hash::Sha256(data));
+  ASSERT_NE(upper, base::ToLowerASCII(upper));
+  auto written = transport_->WriteObject(upper, std::nullopt, data, 0u);
+  ASSERT_TRUE(written.has_value());
+  EXPECT_EQ(server_.vaults["v"].count(base::ToLowerASCII(upper)), 1u);
+  auto read = transport_->ReadObject(upper, 100);
+  ASSERT_TRUE(read.has_value());
+  ASSERT_TRUE(read->has_value());
+  EXPECT_EQ(read->value().data, data);
+}
+
+TEST_F(CorvidSyncTransportTest, ErrorMapping) {
+  server_.offline = true;
+  EXPECT_EQ(transport_->ReadObject("head", 100).error(),
+            SyncVaultTransportError::kNetworkError);
+  server_.offline = false;
+  // The vault is gone (rotated away).
+  server_.vaults.clear();
+  EXPECT_EQ(transport_->ReadObject("head", 100).error(),
+            SyncVaultTransportError::kAccessDenied);
+  server_.devices[device_id_].revoked = true;
+  EXPECT_EQ(transport_->ReadObject("head", 100).error(),
+            SyncVaultTransportError::kAuthenticationRequired);
+}
+
+TEST_F(CorvidSyncTransportTest, CollectCallsBackLater) {
+  base::RunLoop loop;
+  std::optional<SyncVaultTransport::CollectResult> result;
+  transport_->CollectEpochsBefore(
+      3, base::BindOnce(
+             [](std::optional<SyncVaultTransport::CollectResult>* out,
+                base::OnceClosure done, SyncVaultTransport::CollectResult r) {
+               *out = r;
+               std::move(done).Run();
+             },
+             &result, loop.QuitClosure()));
+  EXPECT_FALSE(result);
+  loop.Run();
+  ASSERT_TRUE(result);
+  EXPECT_TRUE(result->has_value());
+}
+
+}  // namespace
+}  // namespace corvid_sync
