+TEST_F(CorvidSyncAccountTest, Recovery) {
+  Account a(&server_, DeviceState());
+  auto key = a.CreateVault(kTestServerUrl, server_.AddToken(), "a");
+  ASSERT_TRUE(key.has_value());
+
+  // Typo: nothing happens, the token stays unspent.
+  const std::string token = server_.AddToken();
+  Account typo(&server_, DeviceState());
+  std::string wrong = *key;
+  wrong[7] = wrong[7] == 'A' ? 'B' : 'A';
+  EXPECT_FALSE(typo.Recover(kTestServerUrl, token, "r", wrong).has_value());
+  EXPECT_FALSE(typo.state().registered());
