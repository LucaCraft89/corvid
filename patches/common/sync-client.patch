+  EXPECT_EQ(a.state().vault_key, b.state().vault_key);
+  EXPECT_EQ(Vault(a), Vault(b));
+  EXPECT_FALSE(b.state().join_secret);
+  EXPECT_TRUE(b.state().roster->IsActive(a.state().device_id));
+  EXPECT_TRUE(b.state().roster->IsActive(b.state().device_id));
