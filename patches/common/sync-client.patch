+
+std::string ErrorName(syncer::SyncVaultStoreError error) {
+  using E = syncer::SyncVaultStoreError;
+  switch (error) {
+    case E::kAuthenticationRequired:
+      return "auth";
+    case E::kConflict:
+      return "conflict";
+    case E::kNetworkError:
+    case E::kTemporaryError:
+    case E::kAborted:
+      return "network";
+    case E::kQuotaExceeded:
+      return "quota";
+    case E::kAccessDenied:
+      return "denied";
+    case E::kRollback:
+      return "rollback";
+    case E::kFork:
+      return "fork";
+    case E::kIncompleteHistory:
+      return "incomplete";
+    case E::kAuthenticationFailed:
+    case E::kInvalidVaultKey:
+    case E::kMalformedObject:
+      return "integrity";
+    case E::kInvalidData:
+    case E::kUnsupported:
+    case E::kUnsupportedVersion:
+    case E::kObjectTooLarge:
+    case E::kCheckpointPersistenceFailed:
+      return "invalid";
+  }
+  return "invalid";
+}
+
+std::optional<std::string> Encrypt(const os_crypt_async::Encryptor& encryptor,
+                                   const std::string& plain) {
+  std::string out;
+  if (!encryptor.EncryptString(plain, &out)) {
+    return std::nullopt;
+  }
+  return base::Base64Encode(out);
+}
+
+std::optional<std::string> Decrypt(const os_crypt_async::Encryptor& encryptor,
+                                   const std::string& stored) {
+  std::string raw;
+  std::string out;
+  if (stored.empty() || !base::Base64Decode(stored, &raw) ||
+      !encryptor.DecryptString(raw, &out)) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterStringPref(kStatePref, std::string());
+  registry->RegisterStringPref(kVaultPref, std::string());
+  registry->RegisterStringPref(kCheckpointPref, std::string());
+  registry->RegisterBooleanPref(kRevokedPref, false);
+  registry->RegisterDictionaryPref(kStatusPref);
+}
+
+void SaveState(PrefService* prefs,
+               const os_crypt_async::Encryptor& encryptor,
+               const DeviceState& state) {
+  if (!state.registered()) {
+    prefs->ClearPref(kStatePref);
+    prefs->ClearPref(kVaultPref);
+    prefs->ClearPref(kCheckpointPref);
+    prefs->ClearPref(kRevokedPref);
+    prefs->ClearPref(kStatusPref);
+    return;
+  }
+  std::optional<std::string> encrypted = Encrypt(encryptor, state.ToJson());
+  if (!encrypted) {
+    LOG(ERROR) << "Corvid sync: could not encrypt the device state";
+    return;
+  }
+  prefs->SetString(kStatePref, *encrypted);
+  prefs->SetBoolean(kRevokedPref, state.revoked);
+  prefs->SetString(kVaultPref, state.vault_uuid);
+}
+
+std::optional<DeviceState> LoadState(
+    const PrefService& prefs,
+    const os_crypt_async::Encryptor& encryptor) {
+  std::optional<std::string> json =
+      Decrypt(encryptor, prefs.GetString(kStatePref));
+  if (!json) {
+    return std::nullopt;
+  }
+  return DeviceState::FromJson(*json);
+}
+
+void SaveCheckpoint(PrefService* prefs,
+                    const os_crypt_async::Encryptor& encryptor,
+                    const syncer::SyncVaultCheckpoint& checkpoint) {
+  auto serialized = syncer::SerializeSyncVaultCheckpoint(checkpoint);
+  if (!serialized.has_value()) {
+    return;
+  }
+  std::optional<std::string> encrypted =
+      Encrypt(encryptor, std::string(serialized->begin(), serialized->end()));
+  if (encrypted) {
+    prefs->SetString(kCheckpointPref, *encrypted);
+  }
+}
+
+std::optional<syncer::SyncVaultCheckpoint> LoadCheckpoint(
+    const PrefService& prefs,
+    const os_crypt_async::Encryptor& encryptor,
+    const std::string& vault_uuid) {
+  std::optional<std::string> plain =
+      Decrypt(encryptor, prefs.GetString(kCheckpointPref));
+  if (!plain) {
+    return std::nullopt;
+  }
+  auto parsed = syncer::ParseSyncVaultCheckpoint(base::as_byte_span(*plain));
+  if (!parsed.has_value() || parsed->vault_uuid != vault_uuid) {
+    return std::nullopt;
+  }
+  return parsed.value();
+}
+
+BackendHost::BackendHost(
+    PrefService* prefs,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : prefs_(prefs), url_loader_factory_(std::move(url_loader_factory)) {}
+
+BackendHost::~BackendHost() = default;
+
+bool BackendHost::IsConfigured() const {
+  return !prefs_->GetString(kVaultPref).empty();
+}
+
+syncer::CustomSyncBackendStatus BackendHost::GetStatus() const {
+  if (!IsConfigured()) {
+    return syncer::CustomSyncBackendStatus::kProviderUnavailable;
+  }
+  return prefs_->GetBoolean(kRevokedPref)
+             ? syncer::CustomSyncBackendStatus::kReconciliationBlocked
+             : syncer::CustomSyncBackendStatus::kEnabled;
+}
+
+std::string BackendHost::GetNamespace() const {
+  const std::string& uuid = prefs_->GetString(kVaultPref);
+  return uuid.empty() ? std::string() : "corvid-sync-" + uuid;
+}
+
+std::unique_ptr<syncer::CustomSyncBackend> BackendHost::CreateBackend(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  if (!encryptor || !IsConfigured()) {
+    return nullptr;
+  }
+  std::optional<DeviceState> state = LoadState(*prefs_, *encryptor);
+  if (!state || !state->has_vault() || state->revoked) {
+    return nullptr;
+  }
+  const std::string uuid = state->vault_uuid;
+  std::optional<syncer::SyncVaultCheckpoint> checkpoint =
+      LoadCheckpoint(*prefs_, *encryptor, uuid);
+
+  // Runs on the sync thread; prefs live on this sequence. A later write of the
+  // same value wins, and losing the newest one in a crash only falls back to
+  // an older ancestor, which still catches rollbacks past it.
+  auto persist = base::BindRepeating(
+      [](scoped_refptr<base::SequencedTaskRunner> runner,
+         base::WeakPtr<BackendHost> host,
+         scoped_refptr<os_crypt_async::Encryptor> encryptor,
+         const syncer::SyncVaultCheckpoint& checkpoint) {
+        auto serialized = syncer::SerializeSyncVaultCheckpoint(checkpoint);
+        if (!serialized.has_value()) {
+          return false;
+        }
+        std::optional<std::string> encrypted = Encrypt(
+            *encryptor, std::string(serialized->begin(), serialized->end()));
+        if (!encrypted) {
+          return false;
+        }
+        runner->PostTask(FROM_HERE,
+                         base::BindOnce(&BackendHost::OnCheckpoint, host,
+                                        checkpoint.vault_uuid,
+                                        std::move(*encrypted)));
+        return true;
+      },
+      base::SequencedTaskRunner::GetCurrentDefault(),
+      weak_factory_.GetWeakPtr(), encryptor);
+
+  auto store = syncer::SyncVaultStore::Create(
+      std::make_unique<ServerVaultTransport>(
+          std::make_unique<UrlLoaderBlockingHttp>(url_loader_factory_->Clone()),
+          state->server_url, state->device_secret, uuid),
+      std::make_unique<syncer::LoopbackServerStateCodec>(), state->vault_key,
+      uuid, std::move(checkpoint), std::move(persist));
+  if (!store.has_value()) {
+    return nullptr;
+  }
+  auto diagnostics = base::BindRepeating(
+      [](scoped_refptr<base::SequencedTaskRunner> runner,
+         base::WeakPtr<BackendHost> host, std::string uuid,
+         std::optional<syncer::SyncVaultStoreError> error,
+         const syncer::SyncVaultCheckpoint& checkpoint,
+         std::optional<syncer::SyncVaultStateDiagnostics>) {
+        runner->PostTask(FROM_HERE,
+                         base::BindOnce(&BackendHost::OnDiagnostics, host, uuid,
+                                        error, checkpoint.generation));
+      },
+      base::SequencedTaskRunner::GetCurrentDefault(),
+      weak_factory_.GetWeakPtr(), uuid);
+  return std::make_unique<syncer::SyncVaultBackend>(std::move(store.value()),
+                                                    std::move(diagnostics));
+}
+
+void BackendHost::OnCheckpoint(std::string vault_uuid, std::string encrypted) {
+  // A late write from the engine of a vault we already left.
+  if (prefs_->GetString(kVaultPref) == vault_uuid) {
+    prefs_->SetString(kCheckpointPref, encrypted);
+  }
+}
+
+void BackendHost::OnDiagnostics(std::string vault_uuid,
+                                std::optional<syncer::SyncVaultStoreError> error,
+                                uint64_t generation) {
+  if (prefs_->GetString(kVaultPref) != vault_uuid) {
+    return;
+  }
+  base::DictValue status = prefs_->GetDict(kStatusPref).Clone();
+  status.Set("generation", base::NumberToString(generation));
+  if (error) {
+    status.Set("last_error", ErrorName(*error));
+  } else {
+    status.Remove("last_error");
+    status.Set("last_success",
+               base::NumberToString(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  }
+  prefs_->SetDict(kStatusPref, std::move(status));
+}
+
