+syncer::SyncVaultTransportError ToTransportError(const ApiError& error);
+
+// Helium's vault transport over the Corvid sync server: object reads and
+// conditional writes map 1:1 onto /v1/vaults/{uuid}/objects/{id}.
+class ServerVaultTransport : public syncer::SyncVaultTransport {
+ public:
+  ServerVaultTransport(std::unique_ptr<BlockingHttp> http,
+                       std::string server_url,
+                       std::string device_secret,
