+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#include "chrome/browser/ui/webui/corvid/diagnostics_log.h"
+
+#include "base/i18n/time_formatting.h"
+#include "base/no_destructor.h"
+#include "base/process/kill.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/child_process_data.h"
+#include "content/public/browser/child_process_termination_info.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/common/process_type.h"
+#include "net/base/net_errors.h"
+#include "url/gurl.h"
+
+namespace corvid {
+
+namespace {
+
+std::string StatusText(base::TerminationStatus status) {
+  switch (status) {
+    case base::TERMINATION_STATUS_PROCESS_WAS_KILLED:
+      return "killed";
+    case base::TERMINATION_STATUS_OOM:
+      return "killed (out of memory)";
+    case base::TERMINATION_STATUS_LAUNCH_FAILED:
+      return "failed to start";
+    default:
+      return "crashed";
+  }
+}
+
+std::string StatusText(const content::ChildProcessTerminationInfo& info) {
+  return base::StrCat({StatusText(info.status), " (exit code ",
+                       base::NumberToString(info.exit_code), ")"});
+}
+
+// "GPU", "Utility (network.mojom.NetworkService)", ...
+std::string ProcessName(const content::ChildProcessData& data) {
+  std::string name = content::GetProcessTypeNameInEnglish(data.process_type);
+  if (!data.metrics_name.empty() && data.metrics_name != name) {
+    name = base::StrCat({name, " (", data.metrics_name, ")"});
+  }
+  return name;
+}
+
+bool IsFailure(base::TerminationStatus status) {
+  return status != base::TERMINATION_STATUS_NORMAL_TERMINATION &&
+         status != base::TERMINATION_STATUS_STILL_RUNNING;
+}
+
+// Watches one tab. Private windows: kind and code only, no host.
+class DiagnosticsTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<DiagnosticsTabHelper> {
+ public:
+  ~DiagnosticsTabHelper() override = default;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    const int error = handle->GetNetErrorCode();
+    if (!handle->IsInPrimaryMainFrame() || error == net::OK ||
+        error == net::ERR_ABORTED) {
+      return;
+    }
+    const std::string code = net::ErrorToShortString(error);
+    const bool tls =
+        net::IsCertificateError(error) || code.starts_with("ERR_SSL_");
+    DiagnosticsLog::Get().Add(tls ? "tls" : "network", code, "",
+                              Host(handle->GetURL()));
+  }
+
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    if (!IsFailure(status)) {
+      return;
+    }
+    DiagnosticsLog::Get().Add("crash", StatusText(status), "Renderer",
+                              Host(web_contents()->GetLastCommittedURL()));
+  }
+
+  void OnRendererUnresponsive(content::RenderProcessHost* host) override {
+    DiagnosticsLog::Get().Add("hang", "page not responding", "Renderer",
+                              Host(web_contents()->GetLastCommittedURL()));
+  }
+
+ private:
+  friend class content::WebContentsUserData<DiagnosticsTabHelper>;
+  explicit DiagnosticsTabHelper(content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        content::WebContentsUserData<DiagnosticsTabHelper>(*web_contents) {}
+
+  std::string Host(const GURL& url) const {
+    // Web sites only, and nothing from private windows.
+    if (web_contents()->GetBrowserContext()->IsOffTheRecord() ||
+        !url.SchemeIsHTTPOrHTTPS()) {
+      return std::string();
+    }
+    return std::string(url.GetHost());
+  }
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(DiagnosticsTabHelper);
+
+}  // namespace
+
+// static
+DiagnosticsLog& DiagnosticsLog::Get() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<DiagnosticsLog> log;
+  return *log;
+}
+
+// static
+void DiagnosticsLog::AttachTo(content::WebContents* web_contents) {
+  Get();  // Starts watching child processes with the first tab.
+  DiagnosticsTabHelper::CreateForWebContents(web_contents);
+}
+
+DiagnosticsLog::DiagnosticsLog() {
+  content::BrowserChildProcessObserver::Add(this);
+}
+
+DiagnosticsLog::~DiagnosticsLog() = default;
+
+void DiagnosticsLog::Add(std::string_view kind,
+                         std::string_view code,
+                         std::string_view process,
+                         std::string_view host) {
+  base::DictValue entry;
+  entry.Set("time", base::TimeFormatAsIso8601(base::Time::Now()));
+  entry.Set("kind", kind);
+  entry.Set("code", code);
+  if (!process.empty()) {
+    entry.Set("process", process);
+  }
+  if (!host.empty()) {
+    entry.Set("host", host);
+  }
+  if (entries_.size() == kCapacity) {
+    entries_.pop_front();
+  }
+  entries_.push_back(std::move(entry));
+  for (Observer& o : observers_) {
+    o.OnDiagnosticsChanged();
+  }
+}
+
+void DiagnosticsLog::Clear() {
+  entries_.clear();
+  for (Observer& o : observers_) {
+    o.OnDiagnosticsChanged();
+  }
+}
+
+base::ListValue DiagnosticsLog::ToValue() const {
+  base::ListValue list;
+  for (const base::DictValue& e : entries_) {
+    list.Append(e.Clone());
+  }
+  return list;
+}
+
+void DiagnosticsLog::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void DiagnosticsLog::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void DiagnosticsLog::BrowserChildProcessCrashed(
+    const content::ChildProcessData& data,
+    const content::ChildProcessTerminationInfo& info) {
+  Add("crash", StatusText(info), ProcessName(data), "");
+}
+
+void DiagnosticsLog::BrowserChildProcessKilled(
+    const content::ChildProcessData& data,
+    const content::ChildProcessTerminationInfo& info) {
+  Add("crash", StatusText(info), ProcessName(data), "");
+}
+
+}  // namespace corvid
