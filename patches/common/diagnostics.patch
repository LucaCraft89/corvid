+// chrome://diagnostics: sends the whole log when the page asks and on every
+// change; clears it on request.
+class DiagnosticsHandler : public content::WebUIMessageHandler,
+                           public DiagnosticsLog::Observer {
+ public:
+  DiagnosticsHandler() = default;
+  DiagnosticsHandler(const DiagnosticsHandler&) = delete;
+  DiagnosticsHandler& operator=(const DiagnosticsHandler&) = delete;
+  ~DiagnosticsHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "corvidGetDiagnostics",
+        base::BindRepeating(&DiagnosticsHandler::HandleGet,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "corvidClearDiagnostics",
+        base::BindRepeating(&DiagnosticsHandler::HandleClear,
+                            base::Unretained(this)));
+  }
+
+  void OnJavascriptAllowed() override {
+    observation_.Observe(&DiagnosticsLog::Get());
+    OnDiagnosticsChanged();
+  }
+
+  void OnJavascriptDisallowed() override { observation_.Reset(); }
+
+  // DiagnosticsLog::Observer:
+  void OnDiagnosticsChanged() override {
+    CallJavascriptFunction("corvidBrowser.dispatch",
+                           base::Value("diagnostics"),
+                           DiagnosticsLog::Get().ToValue());
+  }
+
+ private:
+  void HandleGet(const base::ListValue& args) {
+    if (IsJavascriptAllowed()) {
+      OnDiagnosticsChanged();
+    } else {
+      AllowJavascript();  // Sends the log from OnJavascriptAllowed().
+    }
+  }
+
+  void HandleClear(const base::ListValue& args) {
+    AllowJavascript();
+    DiagnosticsLog::Get().Clear();
+  }
+
+  base::ScopedObservation<DiagnosticsLog, DiagnosticsLog::Observer>
+      observation_{this};
+};
+
 }  // namespace
 
