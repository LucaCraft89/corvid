+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Corvid contributors
+
+#include "chrome/browser/ui/webui/corvid/corvid_ui.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/corvid_webui/grit/corvid_webui_resources.h"
+#include "components/corvid_webui/grit/corvid_webui_resources_map.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "content/public/common/url_constants.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/native_theme/native_theme.h"
+#include "ui/native_theme/native_theme_observer.h"
+#include "ui/webui/webui_util.h"
+
+namespace corvid {
+
+namespace {
+
+constexpr char kInitScript[] = "corvid-init.js";
+// Prefs larger than this are refused (the real ones are a few KB).
+constexpr size_t kMaxPrefsJson = 64 * 1024;
+
+// The desktop accent colour as "#rrggbb", or null when there is none.
+base::Value AccentValue() {
+  std::optional<SkColor> c =
+      ui::NativeTheme::GetInstanceForNativeUi()->user_color();
+  if (!c) {
+    return base::Value();
+  }
+  return base::Value(base::StringPrintf("#%02x%02x%02x", SkColorGetR(*c),
+                                        SkColorGetG(*c), SkColorGetB(*c)));
+}
+
+// window.corvidInit for the page: prefs and accent colour, read before the
+// page script runs so the first frame already has the right theme.
+void ServeInitScript(base::WeakPtr<Profile> profile,
+                     const std::string& path,
+                     content::WebUIDataSource::GotDataCallback callback) {
+  base::DictValue init;
+  if (profile) {
+    init.Set("prefs", profile->GetPrefs()->GetDict(kWebUIPrefs).Clone());
+    init.Set("readOnly", profile->IsOffTheRecord());
+  }
+  init.Set("accent", AccentValue());
+  std::string js = "window.corvidInit = " +
+                   base::WriteJson(init).value_or("{}") + ";\n";
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::move(js)));
+}
+
+// Messages from the pages (webui/src/shared/bridge.ts). Answers by calling
+// corvidBrowser.dispatch(event, value) in the page.
+class CorvidPageHandler : public content::WebUIMessageHandler,
+                          public ui::NativeThemeObserver {
+ public:
+  explicit CorvidPageHandler(Profile* profile) : profile_(profile) {}
+  CorvidPageHandler(const CorvidPageHandler&) = delete;
+  CorvidPageHandler& operator=(const CorvidPageHandler&) = delete;
+  ~CorvidPageHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "corvidReady", base::BindRepeating(&CorvidPageHandler::HandleReady,
+                                           base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "corvidSetPrefs",
+        base::BindRepeating(&CorvidPageHandler::HandleSetPrefs,
+                            base::Unretained(this)));
+  }
+
+  void OnJavascriptAllowed() override {
+    prefs_registrar_.Init(profile_->GetPrefs());
+    prefs_registrar_.Add(kWebUIPrefs,
+                         base::BindRepeating(&CorvidPageHandler::OnPrefsChanged,
+                                             base::Unretained(this)));
+    last_accent_ = AccentValue();
+    theme_observation_.Observe(ui::NativeTheme::GetInstanceForNativeUi());
+  }
+
+  void OnJavascriptDisallowed() override {
+    prefs_registrar_.Reset();
+    theme_observation_.Reset();
+  }
+
+  // ui::NativeThemeObserver:
+  void OnNativeThemeUpdated(ui::NativeTheme* observed_theme) override {
+    base::Value accent = AccentValue();
+    if (accent == last_accent_) {
+      return;
+    }
+    last_accent_ = accent.Clone();
+    CallJavascriptFunction("corvidBrowser.dispatch", base::Value("accent"),
+                           accent);
+  }
+
+ private:
+  void HandleReady(const base::ListValue& args) { AllowJavascript(); }
+
+  void HandleSetPrefs(const base::ListValue& args) {
+    // Private windows show the pages but never save.
+    if (profile_->IsOffTheRecord() || args.size() != 1 ||
+        !args[0].is_string() || args[0].GetString().size() > kMaxPrefsJson) {
+      return;
+    }
+    std::optional<base::Value> value = base::JSONReader::Read(
+        args[0].GetString(), base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (!value || !value->is_dict()) {
+      return;
+    }
+    // The sender already shows the change; tell only the other pages.
+    setting_ = true;
+    profile_->GetPrefs()->SetDict(kWebUIPrefs, std::move(*value).TakeDict());
+    setting_ = false;
+  }
+
+  void OnPrefsChanged() {
+    if (setting_ || !IsJavascriptAllowed()) {
+      return;
+    }
+    CallJavascriptFunction("corvidBrowser.dispatch", base::Value("prefs"),
+                           profile_->GetPrefs()->GetDict(kWebUIPrefs));
+  }
+
+  const raw_ptr<Profile> profile_;
+  PrefChangeRegistrar prefs_registrar_;
+  base::ScopedObservation<ui::NativeTheme, ui::NativeThemeObserver>
+      theme_observation_{this};
+  base::Value last_accent_;
+  bool setting_ = false;
+};
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterDictionaryPref(kWebUIPrefs);
+}
+
+CorvidUIConfig::CorvidUIConfig(std::string_view host, std::string_view page)
+    : WebUIConfig(content::kChromeUIScheme, host), page_(page) {}
+
+CorvidUIConfig::~CorvidUIConfig() = default;
+
+std::unique_ptr<content::WebUIController> CorvidUIConfig::CreateWebUIController(
+    content::WebUI* web_ui,
+    const GURL& url) {
+  return std::make_unique<CorvidUI>(web_ui, host(), page_);
+}
+
+CorvidUI::CorvidUI(content::WebUI* web_ui,
+                   const std::string& host,
+                   const std::string& page)
+    : WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, host);
+
+  // This page's files without the folder name, plus shared/.
+  const std::string prefix = page + "/";
+  int index = 0;
+  for (const webui::ResourcePath& r : kCorvidWebuiResources) {
+    std::string_view path = r.path;
+    if (base::StartsWith(path, prefix)) {
+      path.remove_prefix(prefix.size());
+      source->AddResourcePath(path, r.id);
+      if (path == "index.html") {
+        index = r.id;
+      }
+    } else if (base::StartsWith(path, "shared/")) {
+      source->AddResourcePath(path, r.id);
+    }
+  }
+  CHECK(index) << "no webui page " << page;
+  webui::SetupWebUIDataSource(source, {}, index);
+  source->SetRequestFilter(
+      base::BindRepeating([](const std::string& path) {
+        return path == kInitScript;
+      }),
+      base::BindRepeating(&ServeInitScript, profile->GetWeakPtr()));
+
+  web_ui->AddMessageHandler(std::make_unique<CorvidPageHandler>(profile));
+}
+
+CorvidUI::~CorvidUI() = default;
+
+}  // namespace corvid
