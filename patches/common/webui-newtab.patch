@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Copyright (C) 2026 Corvid contributors
+#
+# Corvid's internal pages. dist/ is built from webui/ in the Corvid repo and
+# copied here by build/webui-sync.sh; it is not part of any patch.
+
+import("//tools/grit/grit_rule.gni")
+import("//ui/webui/resources/tools/generate_grd.gni")
+
+corvid_webui_files = [
+  "shared/base.css",
+  "shared/theme-default.css",
+  "shared/tokens.css",
+  "newtab/index.html",
+  "newtab/newtab.css",
+  "newtab/newtab.js",
+]
+
+generate_grd("build_grd") {
+  grd_prefix = "corvid_webui"
+  out_grd = "$target_gen_dir/resources.grd"
+  input_files = corvid_webui_files
+  input_files_base_dir = rebase_path("dist", "//")
+}
+
+grit("resources") {
+  source = "$target_gen_dir/resources.grd"
+  enable_input_discovery_for_gn_analyze = false
+  use_brotli = true
+  outputs = [
+    "grit/corvid_webui_resources.h",
+    "grit/corvid_webui_resources_map.cc",
+    "grit/corvid_webui_resources_map.h",
+    "corvid_webui_resources.pak",
+  ]
+  deps = [ ":build_grd" ]
+}
