+
+#ifndef CHROME_BROWSER_UI_WEBUI_CORVID_CORVID_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_CORVID_CORVID_UI_H_
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace corvid {
+
+// Profile pref with the settings of the internal pages (search engine, theme,
+// colour, density, shortcuts) as one dictionary. The pages own its format
+// (webui/src/shared/prefs.ts) and sanitize whatever they read.
+inline constexpr char kWebUIPrefs[] = "corvid.webui_prefs";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// chrome://<host>/ serves one page built from webui/ in the Corvid repo:
+// components/corvid_webui/dist/<page>/ plus the shared styles.
+class CorvidUIConfig : public content::WebUIConfig {
+ public:
+  CorvidUIConfig(std::string_view host, std::string_view page);
+  ~CorvidUIConfig() override;
+
+  std::unique_ptr<content::WebUIController> CreateWebUIController(
+      content::WebUI* web_ui,
+      const GURL& url) override;
+
+ private:
+  const std::string page_;
+};
+
+class CorvidUI : public content::WebUIController {
+ public:
+  CorvidUI(content::WebUI* web_ui,
+           const std::string& host,
+           const std::string& page);
+  CorvidUI(const CorvidUI&) = delete;
+  CorvidUI& operator=(const CorvidUI&) = delete;
+  ~CorvidUI() override;
+};
+
+}  // namespace corvid
+
+#endif  // CHROME_BROWSER_UI_WEBUI_CORVID_CORVID_UI_H_
