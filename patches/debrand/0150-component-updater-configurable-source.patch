Purpose: Component updater has no default update server; it only updates from --component-updater=url-source=<url>. Components shipped in the build keep working, they just do not update.
Area: debrand
Files: components/component_updater/configurator_impl.cc
Rebase risk: low because only the default URL list changes
Origin: original (written for Corvid; no third-party patch text reused)

diff --git a/components/component_updater/configurator_impl.cc b/components/component_updater/configurator_impl.cc
index 2ff9716b246f..e35df7c8ea6e 100644
--- a/components/component_updater/configurator_impl.cc
+++ b/components/component_updater/configurator_impl.cc
@@ -80,8 +80,8 @@ std::vector<GURL> ConfiguratorImpl::UpdateUrl() const {
     return {GURL(url_source_override_)};
   }
 
-  std::vector<GURL> urls{GURL(kUpdaterJSONDefaultUrl),
-                         GURL(kUpdaterJSONFallbackUrl)};
+  // No default update source: components only update from --component-updater=url-source=<url>.
+  std::vector<GURL> urls;
   if (require_encryption_) {
     update_client::RemoveUnsecureUrls(&urls);
   }
