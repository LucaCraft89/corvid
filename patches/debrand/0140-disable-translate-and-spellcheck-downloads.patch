 void SpellcheckHunspellDictionary::DownloadDictionary(GURL url) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (url.is_empty()) {
+    InformListenersOfDownloadFailure();
+    return;
+  }
   DCHECK(browser_context_);
 
   download_status_ = DOWNLOAD_IN_PROGRESS;
