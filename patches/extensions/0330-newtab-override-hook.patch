+  if (url->host() == chrome::kChromeUINewTabHost) {
+    // Corvid: resolve the new tab page through corvid::ResolveNewTab. The
+    // candidates keep upstream priority order (most recent first); no pick is
+    // stored yet, so the choice is automatic.
+    std::vector<GURL> all =
+        GetOverridesForChromeURL(*url, browser_context, /*get_all=*/true);
+    Profile* profile = Profile::FromBrowserContext(browser_context);
+    std::vector<corvid::NtpCandidate> candidates;
+    for (size_t i = 0; i < all.size(); ++i) {
+      if (!all[i].SchemeIs(extensions::kExtensionScheme)) {
+        continue;
+      }
+      corvid::NtpCandidate candidate;
+      candidate.extension_id = all[i].host();
+      candidate.enabled_at = base::Time::FromSecondsSinceUnixEpoch(
+          static_cast<double>(all.size() - i));
+      candidate.overrides_newtab = true;
+      candidate.incognito_allowed = extensions::util::IsIncognitoEnabled(
+          candidate.extension_id, profile);
+      candidates.push_back(std::move(candidate));
+    }
+    corvid::NtpResolution resolution =
+        corvid::ResolveNewTab(candidates, /*picked=*/std::nullopt,
+                              profile->IsOffTheRecord(),
+                              /*force_default=*/false);
+    if (!resolution.extension_id) {
+      // Leave chrome://newtab for the Corvid new tab page.
+      return false;
+    }
+    for (const GURL& candidate_url : all) {
+      if (candidate_url.host() == *resolution.extension_id) {
+        *url = candidate_url;
+        return true;
+      }
+    }
+    return false;
+  }
+
   std::vector<GURL> overrides =
       GetOverridesForChromeURL(*url, browser_context, /*get_all=*/false);
   if (overrides.empty()) {
