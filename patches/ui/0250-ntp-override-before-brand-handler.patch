+// Browser patch: an extension's new tab override must see the new tab URL before the brand handler rewrites it to the
+// brand's own new tab page. Also covers the brand-scheme address (except its "?default" escape hatch).
+static bool HandleNtpExtensionOverride(GURL* url,
+                                       content::BrowserContext* browser_context) {
+  const bool stock = url->SchemeIs(content::kChromeUIScheme) &&
+                     url->host() == chrome::kChromeUINewTabHost;
+  const bool brand = url->SchemeIs(corvid::kBrandScheme) &&
+                     url->host() == chrome::kChromeUINewTabHost &&
+                     url->query() != "default";
+  if (!stock && !brand) {
+    return false;
+  }
+  GURL probe(chrome::kChromeUINewTabURL);
+  if (!ExtensionUrlOverrides::HandleChromeURLOverride(
+          &probe, browser_context)) {
+    return false;
+  }
+  *url = probe;
+  return true;
+}
+
 void ChromeContentBrowserClient::BrowserURLHandlerCreated(
     BrowserURLHandler* handler) {
+  handler->AddHandlerPair(&HandleNtpExtensionOverride,
+                          BrowserURLHandler::null_handler());
+
   // Must run first so no other handler sees a stock chrome:// WebUI URL.
   corvid::RegisterBrandUrlHandlers(handler);
 
