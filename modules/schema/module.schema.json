{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corvid.invalid/schema/module.schema.json",
  "title": "Corvid module manifest (apiVersion 0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "apiVersion", "name", "kind"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$", "maxLength": 100 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "type": "integer", "minimum": 0 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Display name, or an i18n:<key> reference." },
    "description": { "type": "string", "maxLength": 500, "description": "Plain text or an i18n:<key> reference." },
    "kind": { "enum": ["builtin", "ui-mod"] },
    "author": { "type": "string", "maxLength": 120 },
    "license": { "type": "string", "maxLength": 60 },
    "slots": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/slot" }
    },
    "settings": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/setting" }
    },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/permission" } },
    "optionalPermissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/permission" } },
    "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" } },
    "entry": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.js$", "description": "Relative path inside the module package; no parent traversal." }
  },
  "definitions": {
    "permission": {
      "enum": [
        "tabs.read", "tabs.manage", "bookmarks.read", "bookmarks.manage",
        "storage.local", "theme.read", "layout.read", "layout.write",
        "notifications", "internal.shell", "internal.settings", "internal.extensions"
      ]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "component"],
      "properties": {
        "slot": { "enum": ["window.top", "window.bottom", "window.left", "window.right", "window.floating"] },
        "component": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$", "description": "Custom element tag name (must contain a hyphen)." },
        "title": { "type": "string", "maxLength": 120 },
        "role": { "enum": ["tabs", "addressbar", "layout-menu"], "description": "Guard-rail role; layouts must keep a visible component for each role." },
        "movable": { "type": "boolean", "default": true },
        "resizable": { "type": "boolean", "default": false },
        "hideable": { "type": "boolean", "default": true },
        "allowedSlots": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["window.top", "window.bottom", "window.left", "window.right", "window.floating"] }
        },
        "minSize": { "type": "number", "minimum": 0 },
        "maxSize": { "type": "number", "minimum": 0 },
        "defaultSize": { "type": "number", "minimum": 0 },
        "mode": { "enum": ["fill", "wrap", "replace"], "default": "fill" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "default"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$" },
        "type": { "enum": ["boolean", "enum", "string", "number", "color"] },
        "default": {},
        "label": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 300 },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] }, "then": { "required": ["values"], "properties": { "values": {} } } }
      ]
    }
  }
}
