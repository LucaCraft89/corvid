{
  "$schema": "../schema/module.schema.json",
  "id": "corvid.privacy",
  "version": "0.1.0",
  "apiVersion": 0,
  "name": "i18n:module.privacy.name",
  "description": "i18n:module.privacy.description",
  "kind": "builtin",
  "settings": [
    {
      "key": "privacy.webrtcIpHandling",
