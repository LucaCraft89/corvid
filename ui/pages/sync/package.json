{
  "name": "corvid-sync-page",
  "private": true,
  "version": "0.1.0",
  "description": "corvid://sync WebUI page (Lit). Draft: Mojo bridge not wired; see src-overlay/corvid/sync/webui/.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/sync-page.ts --bundle --format=esm --outfile=dist/sync-page.js --loader:.json=json",
    "test": "npm run typecheck && node --test test/sync-page.test.mjs"
  },
  "dependencies": {
    "lit": "3.2.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3"
  }
}
