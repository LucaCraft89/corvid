{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://corvid.invalid/schema/layout.schema.json",
  "title": "Corvid layout (version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "regions"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "bottom", "left", "right", "floating"],
      "properties": {
        "top": { "$ref": "#/definitions/region" },
        "bottom": { "$ref": "#/definitions/region" },
        "left": { "$ref": "#/definitions/region" },
        "right": { "$ref": "#/definitions/region" },
        "floating": { "$ref": "#/definitions/region" }
      }
    },
    "breakpoints": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["maxWidth", "layout"],
        "properties": {
          "maxWidth": { "type": "integer", "minimum": 1, "description": "CSS px viewport width at or below which `layout` applies." },
          "layout": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "value"],
      "properties": {
        "unit": { "enum": ["rem", "fr", "%"] },
        "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "properties": {
        "slots": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/slot" } },
        "size": { "$ref": "#/definitions/size" },
        "collapsed": { "type": "boolean" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "moduleId", "component", "visible"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,80}$" },
        "moduleId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
        "component": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$" },
        "visible": { "type": "boolean" },
        "row": { "type": "integer", "minimum": 0, "maximum": 15, "description": "top/bottom regions: consecutive slots with equal row share one horizontal row." },
        "size": { "$ref": "#/definitions/size" },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
        }
      }
    }
  }
}
